#!/usr/bin/env -S python3 -I
"""Entry point of the `kb` command; runs under the system python3 in isolated mode (-I)
from any directory. The core stages need the standard library only."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from kbtool.cli import main  # noqa: E402

sys.exit(main())
