# D1 of tracks/E-stoch-inf/codebase/JOURNAL.md: memory and throughput of vacuum Z4c
# in a periodic box (processor executable). Mesh and MeshBlock sizes set on the command line.
<job>
basename  = mem
<mesh>
nghost    = 4
nx1       = 64
x1min     = -0.5
x1max     = 0.5
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 64
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 64
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic
<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32
<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 4
tlim       = 1.0
ndiag      = 1
<z4c>
lapse_oplog     = 0.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 0.0
shift_Gamma     = 0.0
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.5
damp_kappa1     = 0.0
<problem>
pgen_name = z4c_linear_wave
amp       = 1.0e-6
kx1       = 1.0
kx2       = 0.0
kx3       = 0.0
