g05_p  tracks/E-stoch-inf/window/inputs/usr_256.athinput mesh/nx1=128 mesh/nx2=128 mesh/nx3=128 meshblock/nx1=128 meshblock/nx2=128 meshblock/nx3=128 scalar_field/noise_nmax2=1024 scalar_field/noise_mode_file=/data/haiyangw/nrpic/wt/E-stoch-inf/tracks/E-stoch-inf/usr/inputs/modes_usr_n1024.txt scalar_field/noise_sharpness=5.0 scalar_field/noise_sigma=0.5 scalar_field/noise_mode_scale=1.0
