  "command": [
    "python3",
    "-c",
    "\nimport numpy as np, json\nz=np.load('/data/haiyangw/nrpic/scratch/E-stoch-inf/E-20261123-014858-8e72d4c/coeffs_N256.npz')\nlo=(z['n']**2).sum(axis=1)<=256\nout={}\nfor tag,(p,m,s) in {'s1':('c_U256','c_U256m',1.0),'s1/2':('c_U256h','c_U256hm',0.5)}.items():\n    q=0.5*(z[p]-z[m])/s/z['cref']-1.0\n    out[tag]=dict(mean_re_Nf=float(q.real[-1,lo].mean()),std_re_Nf=float(q.real[-1,lo].std()),mean_re_t=[float(x) for x in q.real[:,lo].mean(axis=1)])\nout['ratio_Nf']=out['s1']['mean_re_Nf']/out['s1/2']['mean_re_Nf']\nout['ratio_t']=[a/b if b else None for a,b in zip(out['s1']['mean_re_t'],out['s1/2']['mean_re_t'])]\nout['cN']=[float(x) for x in z['cN']]\nprint(json.dumps(out,indent=0))\n"
