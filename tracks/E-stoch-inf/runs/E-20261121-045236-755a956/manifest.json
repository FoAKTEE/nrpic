  "kind": "scouting",
  "purpose": "ladder item (d): which modes set max D_n (|n| <= 32) in the two realisations of P256: amplitude |alpha_n| and absolute deviation of the five largest (outlier check after PD2, JOURNAL 22)",
  "preregistered_in": null,
  "launcher": "local",
  "command": [
    "python3",
    "-c",
    "\nimport numpy as np\nfor tag, f in (('seed1', '/data/haiyangw/nrpic/scratch/E-stoch-inf/E-20261115-194633-9e04ed8/res/P256.npz'), ('seed2', '/data/haiyangw/nrpic/scratch/E-stoch-inf/E-20261121-045105-f797ebb/res/P256s2.npz')):\n    z = np.load(f)\n    rnr, lin, n2, al = z['rnr'][-1], z['lin'][-1], z['n2'], z['alpha']\n    sel = n2 <= 1024\n    d = np.abs(rnr / lin - 1.0)\n    a = np.abs(al) / np.sqrt(np.mean(np.abs(al[sel])**2))\n    ab = np.abs(rnr - lin) / np.sqrt(np.mean(np.abs(lin[sel])**2))\n    idx = np.nonzero(sel)[0][np.argsort(d[sel])[::-1][:5]]\n    print(tag, 'rms|alpha| norm 1; fraction of |n|<=32 modes with |alpha|/rms < 0.05:', float(np.mean(a[sel] < 0.05)))\n    for i in idx:\n        print(f'  n2={int(n2[i])} D={d[i]:.3e} |alpha|/rms={a[i]:.3e} |R_NR-R_lin|/rms|R_lin|(all |n|<=32)={ab[i]:.3e} D*|alpha|/rms={d[i]*a[i]:.3e}')\n    big = sel & (a > 0.5)\n    print('  max D over |n|<=32 modes with |alpha|/rms > 0.5:', float(d[big].max()), 'at n2', int(n2[big][np.argmax(d[big])]))\n"
  ],
