# Ladder row 4 on the M/8 mesh (batch 5, 2026-11-21): problems/st/st_cluster_amr.athinput with a
# static mesh: the level-6 nest (dx = M/4) inside |x|_inf < 6 M as before and a level-7 region
# (dx = M/8) inside |x|_inf < 3.9 M (Track C's M/8 region, tracks/C-sidm/drift), nothing finer.
# Written by hand from the release input; particle and table files are given on the command line.

<comment>
problem   = monoenergetic relativistic cluster, static M/8 mesh (ladder row 4)

<job>
basename  = st

<mesh>
nghost    = 4
nx1       = 64
x1min     = -512.0
x1max     = 512.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -512.0
x2max     = 512.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -512.0
x3max     = 512.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement          = static
num_levels          = 8
max_nmb_per_rank    = 1024

<refined_region1>
level = 6
x1min = -6.0
x1max = 6.0
x2min = -6.0
x2max = 6.0
x3min = -6.0
x3max = 6.0

<refined_region2>
level = 7
x1min = -3.9
x1max = 3.9
x2min = -3.9
x2max = 3.9
x3min = -3.9
x3max = 3.9

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 300.0
ndiag      = 400

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
damp_ch         = 0.0
damp_ch_dx      = 0.0

<fastflow>
find_every        = 32
metric_drvts      = interpolant
num_horizons      = 1
npunct            = 0
ntheta            = 16
lmax              = 8
use_puncture_0    = -1
center_x_0        = 0.0
center_y_0        = 0.0
center_z_0        = 0.0
initial_radius_0  = 1.0
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-5
start_time_0      = 10.0
stop_time_0       = 10000.0
verbose           = false

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-7
max_iterations = 50
deposit        = true
nfilter        = 4
filter_compensate = true
filter_comp_c  = -1.0
deposit_max_level = 31
deposit_adaptive  = false
deposit_min_level = 6
deposit_ppc       = 2.0
deposit_max_coarsen = 31
alpha_exc      = 0.1
hist_dcycle    = 8
snap_dt        = 5.0
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cf
ncomp      = 1
comp0_type = table
comp0_file = cluster.tab
lapse      = table

<output1>
file_type = hst
dt        = 1.0

<output2>
file_type = rst
dt        = 20.0
