# COPY for core's package step-limit of track/A-emd-pbh:tracks/A-emd-pbh/periodic_diag/inputs/diag_uniform.athinput at commit 8d206e20 (Track A's reproducer; unchanged below this line)
# periodic_diag (Track A, batch 6): the physics of periodic_threshold/inputs/peak_leak.athinput
# (relaxed 1+log lapse lapse_leak 20, Gamma-driver shift_Gamma 0.75 / eta 2 with advection,
# cfl_number 1.0 with dt_lightspeed 0.25, constraint damping kappa1 0.5/alpha, KO diss 0.5,
# guard, the same particle and deposit options) on the 64^3 root mesh WITHOUT the four static
# levels, so that the step is set by the root cells (dx = 0.3125).  Removed against
# peak_leak: <mesh_refinement>, <refined_region1..4>, <fastflow> (its first search was at
# t = 40), the restart and the slice outputs; cstat every cycle, trajectories and region
# norms off.  The variants of JOURNAL.md (U0 to U5) change one parameter each on the command
# line (scripts/run_uniform.sh).

<comment>
problem   = periodic peak, relaxed 1+log lapse: uniform 64^3 mesh (diagnosis periodic_diag)

<job>
basename  = peak

<mesh>
nghost    = 4
nx1       = 64
x1min     = -10.0
x1max     = 10.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 64
x2min     = -10.0
x2max     = 10.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 64
x3min     = -10.0
x3max     = 10.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 1.0                        # with z4c/dt_lightspeed = 0.25 (header)
nlim       = -1
tlim       = 12.0
ndiag      = 1

<z4c>
lapse_oplog     = 2.0                  # 1+log: d_t alpha = -2 alpha Khat
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_volume    = 0.0
lapse_kdriver   = 0.0
lapse_advect    = 1.0
lapse_leak      = 20.0                 # 1/T of the relaxation of the excess lapse; T = 0.05
lapse_leak_alpha = 1.0                 # reference lapse
dt_lightspeed   = 0.25                 # dt <= cfl 0.25 dx / c_max (header)
shift_Gamma     = 0.75                 # Gamma-driver (core's ball_leak, es_gauge)
shift_alpha2Gamma = 0.0
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-8
damp_kappa1     = 0.5                  # constraint damping as in S1 (peak_smr4)
damp_kappa1_over_alpha = true
damp_kappa2     = 0.0
damp_kappa_gam  = 0.0
damp_ch         = 0.0
damp_ch_dx      = 0.0
damp_ch_chipow  = 0.0
excise_chi      = 0.0

<z4c_guard>
stop_nonfinite       = true            # stop with exit status 3 when a field is not finite
stop_chi_nonpositive = true            # also when the conformal factor is zero or negative

<particles>
particle_type  = nrpic
pusher         = midpoint
interp         = hermite
dt_expansion   = 0.05
metric         = mesh
tolerance      = 1.0e-12
max_iterations = 50
deposit        = true
nfilter        = 2
filter_compensate = true
filter_comp_c  = -1.0
deposit_comp_c = 0.0
deposit_comp_limit = 0.0
deposit_comp_c2 = 0.0
deposit_shape  = cic
deposit_max_level = 31
deposit_adaptive  = true
deposit_min_level = 0
deposit_ppc       = 2.0
deposit_max_coarsen = 31
alpha_exc      = 0.1
ah_exc_factor  = -1.0
hist_dcycle    = 1
cstat_dcycle   = 1
cons_dcycle    = 0
line_dcycle    = 0
traj_dcycle    = 0
traj_ntrack    = 0
snap_dt        = 1000.0
probe_x1       = 0.001
probe_x2       = 0.001
probe_x3       = 0.001
nprobe         = 0
lambda         = 0.0
source_density = true
source_extrap  = true
region_dcycle  = 0                     # <basename>.region.hst: norms of H and 16 pi E inside/outside
region_radius1 = 2.449489742783178     # compaction radius sqrt(6)/k
region_radius2 = 0.6
region_horizon = 0                     # and inside/outside the horizon of finder 0 once found
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cosmo
id         = file
id_file    = fields.bin
hubble     = 1.0

<output1>
file_type = hst
dt        = 0.05

<output2>
file_type = tab
variable  = z4c
dt        = 0.5
slice_x2  = 0.15625                  # a line of cell centres through the peak region
slice_x3  = 0.15625

<output3>
file_type = tab
variable  = con
dt        = 0.5
slice_x2  = 0.15625
slice_x3  = 0.15625
