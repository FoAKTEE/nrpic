# Package faces (outer boundaries of Z4c): proxy of Track D's long vacuum-puncture run
# (tracks/D-bh-dress/puncture_drift) for the processors.  One Brill-Lindquist puncture of
# bare mass 1, static refinement to cells of 1/4 (as punc.athinput but with the refined
# regions shrunk to |x| < 4 and |x| < 2), outflow faces at 16 M instead of 128 M, the
# horizon finder with the settings of problems/puncture/horizon_calib.athinput.  The
# faces are eight times nearer than in Track D's run, so what they send to the hole
# arrives eight times sooner (from t of about 23 M on).
# Variants from the command line: z4c/sbc_variant=sommerfeld|nonwave, z4c/extrap_order.

<comment>
problem   = puncture, outflow faces at 16 M

<job>
basename  = punc

<mesh>
nghost    = 4
nx1       = 32
x1min     = -16.0
x1max     = 16.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 32
x2min     = -16.0
x2max     = 16.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 32
x3min     = -16.0
x3max     = 16.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<mesh_refinement>
refinement       = static
max_nmb_per_rank = 4096

<refined_region1>
level = 1
x1min = -3.9
x1max = 3.9
x2min = -3.9
x2max = 3.9
x3min = -3.9
x3max = 3.9

<refined_region2>
level = 2
x1min = -1.9
x1max = 1.9
x2min = -1.9
x2max = 1.9
x3min = -1.9
x3max = 1.9

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 40.0
ndiag      = 16

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
extrap_order    = 2
sbc_variant     = nonwave   # radiative condition with a non-wave part (z4c_sbc_ext.hpp)
sbc_power_khat  = 3.0
sbc_power_a     = 3.0
sbc_power_gam   = 3.0
sbc_theta       = sommerfeld
sbc_power_theta = 3.0
sbc_v_khat      = 1.4142135623730951

<fastflow>
find_every        = 16
metric_drvts      = interpolant
num_horizons      = 1
npunct            = 0
ntheta            = 16
lmax              = 8
use_puncture_0    = -1
center_x_0        = 0.0
center_y_0        = 0.0
center_z_0        = 0.0
initial_radius_0  = 0.8
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-5
start_time_0      = 0.0
stop_time_0       = 1000.0
verbose           = false

<problem>
pgen_name       = nrpic_cf
ncomp           = 1
comp0_type      = puncture
comp0_mass      = 1.0
comp0_x1        = 0.0
comp0_p1        = 0.0
comp0_p2        = 0.0
comp0_p3        = 0.0
comp0_s1        = 0.0
comp0_s2        = 0.0
comp0_s3        = 0.0
comp0_corr      = none
lapse           = precollapsed

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = bin
variable  = con
dt        = 1.0

<output3>
file_type = bin
variable  = z4c
dt        = 1.0
