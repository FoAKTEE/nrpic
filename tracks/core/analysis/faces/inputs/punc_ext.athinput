# punc_ext.athinput: punc.athinput with every option of the outer faces (z4c_sbc_ext.hpp) set to the
# value of the stock conditions, so that each can be changed on the command line.
# Package faces (outer boundaries of Z4c): one puncture of bare mass 1 at the origin
# (a cell corner) in moving-puncture gauge, static refinement (cells of 1, 1/2, 1/4),
# outflow faces at 16.  With comp0_p1 = 0 a Brill-Lindquist (vacuum, K_ij = 0)
# puncture; with comp0_p1 = 0.3 a Bowen-York puncture (K_ij falls as r^(-2)) with the
# closed-form correction of the conformal factor.  The puncture is resolved by M/4 only:
# the runs measure the outer faces, not the hole.
# Variants from the command line: mesh/nx*, mesh/x*min, x*max (reference box),
# problem/comp0_p1, problem/comp0_corr, z4c/extrap_order, the <z4c> sbc_* options.

<comment>
problem   = puncture, outflow faces at 16 M

<job>
basename  = punc

<mesh>
nghost    = 4
nx1       = 32
x1min     = -16.0
x1max     = 16.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 32
x2min     = -16.0
x2max     = 16.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 32
x3min     = -16.0
x3max     = 16.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<mesh_refinement>
refinement       = static
max_nmb_per_rank = 4096

<refined_region1>
level = 1
x1min = -7.9
x1max = 7.9
x2min = -7.9
x2max = 7.9
x3min = -7.9
x3max = 7.9

<refined_region2>
level = 2
x1min = -3.9
x1max = 3.9
x2min = -3.9
x2max = 3.9
x3min = -3.9
x3max = 3.9

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 12.0
ndiag      = 16

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
extrap_order    = 2
sbc_variant     = sommerfeld   # options of the outer faces (z4c_sbc_ext.hpp); these
sbc_power_khat  = 3.0          # values give the stock conditions of the release
sbc_power_a     = 3.0
sbc_power_gam   = 3.0
sbc_theta       = sommerfeld   # sommerfeld | nonwave | cpbc
sbc_power_theta = 3.0
sbc_v_khat      = 1.4142135623730951
sbc_speed       = unit         # unit | lapse | metric
ghost_falloff   = false        # ghost cells by fall-off extrapolation
ghost_power_metric = 1.0
ghost_power_curv   = 1.0

<problem>
pgen_name       = nrpic_cf
ncomp           = 1
comp0_type      = puncture
comp0_mass      = 1.0
comp0_x1        = 0.0
comp0_p1        = 0.0
comp0_p2        = 0.0
comp0_p3        = 0.0
comp0_s1        = 0.0
comp0_s2        = 0.0
comp0_s3        = 0.0
comp0_corr      = none
lapse           = precollapsed

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = bin
variable  = con
dt        = 1.0

<output3>
file_type = bin
variable  = z4c
dt        = 1.0
