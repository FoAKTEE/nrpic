# Card check of core/restart-finder: problems/tests/finder_polish.athinput with
# <particles> ah_exc_max_growth = 0.4 (tracks/core/analysis/restart_finder/card_check.py).
<comment>
problem   = one puncture, horizon finder with polishing, test particles with horizon excision

<job>
basename  = fp

<mesh>
nghost    = 4
nx1       = 32
x1min     = -8.0
x1max     = 8.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 32
x2min     = -8.0
x2max     = 8.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 32
x3min     = -8.0
x3max     = 8.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<mesh_refinement>
refinement          = adaptive
num_levels          = 3
max_nmb_per_rank    = 1024
ncycle_check        = 2
refinement_interval = 2

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 8.0
ndiag      = 16

<z4c>
lapse_oplog     = 2.0
shift_Gamma     = 0.75
shift_eta       = 2.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
tracker_mode    = ode

<fastflow>
find_every          = 4
mass_tol_0          = 1.0e-5   # the mass rule: change of the mass between two iterations
flow_iterations_0   = 400
polish_iterations_0 = 0        # iterations after the mass rule is met (0: none, as before)
initial_radius_0    = 1.0
diagnostics         = true     # <basename>.horizon_status_0.txt: found or not, reason, flow iterations

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-10
max_iterations = 100
particle_file  = infall.nrp
deposit        = false
alpha_exc      = -1.0
ah_exc_factor  = 0.8
ah_exc_max_growth = 0.4       # guard radius 0.4 M, inside the horizon (0.47 M): no horizon excision
removal_record = true
hist_dcycle    = 4

<problem>
pgen_name       = nrpic_cf
ncomp           = 1
comp0_type      = puncture
comp0_mass      = 1.0
comp0_x1        = 0.0
comp0_x2        = 0.0
comp0_x3        = 0.0
comp0_corr      = approx
lapse           = precollapsed
puncture_setup  = true
puncture_radius = 1.2

<output1>
file_type = hst
dt        = 0.25
