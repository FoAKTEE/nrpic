+// DIAGNOSTIC of work package omp (tracks/core/omp/tools/mg_average_diag.patch; never part
+// of the source tree): the volume-weighted sum of CalculateAverage in an order that does
+// not depend on the number of threads. Every line (m,k,j) is summed over i by one thread,
+// the line sums are added on the calling thread in index order. comp: both sums with
+// Neumaier's compensation (error of the order of one rounding of the result instead of
+// the accumulated rounding of the plain sum).
+
+namespace {
+inline void DiagAdd(Real &s, Real &c, const Real x, const bool comp) {
+  if (comp) {
+    volatile Real t = s + x;
+    if (std::abs(s) >= std::abs(x)) {
+      volatile Real d = s - t;
+      c += d + x;
+    } else {
+      volatile Real d = x - t;
+      c += d + s;
+    }
+    s = t;
+  } else {
+    s += x;
+  }
+}
+
+template <typename ViewT, typename RdxT>
+Real DiagOrderedSum(const ViewT &data, const RdxT &brdx, int nmmb, int ks, int ke,
+                    int js, int je, int is, int ie, int ll, bool comp) {
+  const int nk = ke - ks + 1, nj = je - js + 1;
+  Kokkos::View<Real***, Kokkos::HostSpace> line("mg_avg_line", nmmb, nk, nj);
+  Kokkos::parallel_for("MG::AverageLines",
+    Kokkos::RangePolicy<Kokkos::DefaultHostExecutionSpace>(0, nmmb*nk*nj),
+    [=](const int idx) {
+      const int m = idx/(nk*nj);
+      const int k = (idx - m*nk*nj)/nj;
+      const int j = idx - m*nk*nj - k*nj;
+      Real dx_m = brdx(m) * static_cast<Real>(1 << ll);
+      Real dV_m = dx_m * dx_m * dx_m;
+      Real s = 0.0, c = 0.0;
+      for (int i = is; i <= ie; ++i) {
+        DiagAdd(s, c, data(m, 0, k + ks, j + js, i) * dV_m, comp);
+      }
+      line(m, k, j) = s + c;
+    });
+  Real s = 0.0, c = 0.0;
+  for (int m = 0; m < nmmb; ++m) {
+    for (int k = 0; k < nk; ++k) {
+      for (int j = 0; j < nj; ++j) {
+        DiagAdd(s, c, line(m, k, j), comp);
+      }
+    }
+  }
+  return s + c;
+}
+} // namespace
