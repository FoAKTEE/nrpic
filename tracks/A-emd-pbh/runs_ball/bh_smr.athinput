# BH-1R of Track A (wave 2b): BH-1 (bh.athinput, data set 3) with one level of static
# refinement: root cells M/8 on [-16, 16]^3 (256^3 in blocks of 32^3), cells M/16 inside
# [-4, 4]^3 (the region of the collapsing core and of the forming horizon), lattice h = M/16
# (n_lat = 136: one particle per fine cell, eight per root cell); clouds at the finest local
# level (default rule of coord/INTERFACES/deposit.md). Give on the command line:
#   problem/comp0_file=<prep>/<stem>.tab
#   particles/particle_file=<prep>/lat136/<stem>_lat136_track.nrp   particles/traj_ntrack=<n_track>
# The x-axis table outputs mix cells of both levels; compare.py's line diagnostics assume a
# uniform line and are not used for this run. JOURNAL.md entry 10 (prediction).

<comment>
problem   = expanding dust ball, data set 3, relaxed 1+log lapse, one refined level

<job>
basename  = ball

<mesh>
nghost    = 4
nx1       = 256
x1min     = -16.0
x1max     = 16.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 256
x2min     = -16.0
x2max     = 16.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 256
x3min     = -16.0
x3max     = 16.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<mesh_refinement>
refinement       = static
max_nmb_per_rank = 1024

<refined_region1>
level = 1
x1min = -3.9
x1max = 3.9
x2min = -3.9
x2max = 3.9
x3min = -3.9
x3max = 3.9

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 16.0
ndiag      = 10

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_volume    = 0.0
lapse_advect    = 1.0
lapse_leak      = 8.0      # 1/T of the relaxation of the excess lapse; T = 0.125 M
lapse_leak_alpha = 1.0     # reference lapse
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
excise_chi      = 0.0

<fastflow>
find_every        = 8
metric_drvts      = interpolant
num_horizons      = 1
npunct            = 0
ntheta            = 16
lmax              = 8
use_puncture_0    = -1
center_x_0        = 0.0
center_y_0        = 0.0
center_z_0        = 0.0
initial_radius_0  = 3.0
flow_iterations_0 = 1000
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-6
start_time_0      = 8.0
stop_time_0       = 1000.0
verbose           = false

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
interp         = bspline
tolerance      = 1.0e-10
max_iterations = 50
deposit        = true
deposit_shape  = pcs
deposit_comp_c = 0.1666666666666667
deposit_comp_c2 = 0.4666666666666667
nfilter        = 0
filter_compensate = false
source_density = true
source_extrap  = true
alpha_exc      = 0.1
hist_dcycle    = 1
cstat_dcycle   = 1
traj_dcycle    = 8
traj_ntrack    = 0
snap_dt        = 2.0
field_constraints = true
field_time1    = 4.0
field_time2    = 8.0
field_time3    = 10.0
field_time4    = 12.0
particle_file  = ball.nrp

<problem>
pgen_name  = nrpic_cf
ncomp      = 1
comp0_type = table
comp0_file = ball.tab
lapse      = table
lapse_comp = 0
shift      = zero

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = rst
dt        = 1000.0

<output3>
file_type = tab
variable  = adm
dt        = 0.25
slice_x2  = 0.01
slice_x3  = 0.01
data_format = %.12e

<output4>
file_type = tab
variable  = z4c
dt        = 0.25
slice_x2  = 0.01
slice_x3  = 0.01
data_format = %.12e

<output5>
file_type = tab
variable  = con
dt        = 0.25
slice_x2  = 0.01
slice_x3  = 0.01
data_format = %.12e

<output6>
file_type = tab
variable  = tmunu
dt        = 0.25
slice_x2  = 0.01
slice_x3  = 0.01
data_format = %.12e
