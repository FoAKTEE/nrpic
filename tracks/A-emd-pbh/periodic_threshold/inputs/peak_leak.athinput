# The periodic peak of peak_smr4.athinput (same mesh: root 64^3 over [-10, 10]^3, four
# static levels, finest k dx = 0.0195 inside |x| < 0.625; same deposit, constraint damping
# and outputs) with the gauge changed to the relaxed 1+log lapse of core's gauge package
# (scratch/core/exe/core_gauge/READY, option 1; athenak/src/z4c/z4c_gauge_ext.hpp of
# branch core/gauge) and a Gamma-driver shift, as core's problems/ball/ball_leak.athinput
# and problems/es/es_gauge.athinput:
#   d_t alpha = beta^i d_i alpha - 2 alpha Khat - (alpha/T) max(ln alpha, 0),  T = 1/lapse_leak,
#   d_t beta^i = (3/4) Btilde^i (Gamma-driver, eta = 2, advection), zero at the start.
# T = 0.05 (lapse_leak = 20): core's rule T <= 0.1 R/sqrt(2 alpha) for the smallest
# expanding region that must be followed gives 0.15 for the compaction region (R = r_m =
# 2.45 at a = 1, alpha = exp(6 T H_i) = 1.35) and 0.06 for the shell r = 1; lapse_leak x dt
# = 20 x 0.0049 = 0.1 (cfl 0.25) and 0.39 (cfl 1.0), below 2.7. In the background the
# lapse tends to exp(6 T H) (1.35 at the start, 1.06 at t = 3, 1.002 at t = 100), so the
# coordinate time is close to the proper time of the dust far from the peak.
# Excision: particles where alpha < 0.1 (as core's ball_collapse and the track's horizon
# run A-20261119-164634-f1fe887); in the E1 gauge of S1 the threshold 0.3 referred to a
# lapse of order a.
# Wave 3, package periodic_threshold (DESIGN.md section 7, JOURNAL.md wave 3). Runs P0L
# (spherical peak, data of build_p0l.sh) and S1L (the S1 data). Every parameter given on
# the command line is declared here: time/tlim, time/cfl_number, problem/id_file,
# particles/particle_file, particles/traj_ntrack, fastflow/start_time_0,
# fastflow/initial_radius_0, z4c/lapse_leak.

<comment>
problem   = single curvature peak in a periodic matter-era box, relaxed 1+log lapse

<job>
basename  = peak

<mesh>
nghost    = 4
nx1       = 64
x1min     = -10.0
x1max     = 10.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 64
x2min     = -10.0
x2max     = 10.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 64
x3min     = -10.0
x3max     = 10.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement          = static
max_nmb_per_rank    = 4096

<refined_region1>
level = 1
x1min = -5.0
x1max = 5.0
x2min = -5.0
x2max = 5.0
x3min = -5.0
x3max = 5.0

<refined_region2>
level = 2
x1min = -2.5
x1max = 2.5
x2min = -2.5
x2max = 2.5
x3min = -2.5
x3max = 2.5

<refined_region3>
level = 3
x1min = -1.25
x1max = 1.25
x2min = -1.25
x2max = 1.25
x3min = -1.25
x3max = 1.25

<refined_region4>
level = 4
x1min = -0.625
x1max = 0.625
x2min = -0.625
x2max = 0.625
x3min = -0.625
x3max = 0.625

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 10.0
ndiag      = 50

<z4c>
lapse_oplog     = 2.0                  # 1+log: d_t alpha = -2 alpha Khat
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_volume    = 0.0
lapse_kdriver   = 0.0
lapse_advect    = 1.0
lapse_leak      = 20.0                 # 1/T of the relaxation of the excess lapse; T = 0.05
lapse_leak_alpha = 1.0                 # reference lapse
shift_Gamma     = 0.75                 # Gamma-driver (core's ball_leak, es_gauge)
shift_alpha2Gamma = 0.0
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-8
damp_kappa1     = 0.5                  # constraint damping as in S1 (peak_smr4)
damp_kappa1_over_alpha = true
damp_kappa2     = 0.0
damp_kappa_gam  = 0.0
damp_ch         = 0.0
damp_ch_dx      = 0.0
damp_ch_chipow  = 0.0
excise_chi      = 0.0

<fastflow>
find_every        = 32                 # every 0.16 (cfl 0.25) or 0.62 (cfl 1.0) time units
metric_drvts      = interpolant
num_horizons      = 1
npunct            = 0
ntheta            = 16
lmax              = 8
use_puncture_0    = -1
center_x_0        = 0.0
center_y_0        = 0.0
center_z_0        = 0.0
initial_radius_0  = 1.2
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-5
start_time_0      = 50.0
stop_time_0       = 1000.0
verbose           = false

<particles>
particle_type  = nrpic
pusher         = midpoint
interp         = hermite
dt_expansion   = 0.05
metric         = mesh
tolerance      = 1.0e-12
max_iterations = 50
deposit        = true
nfilter        = 2
filter_compensate = true
filter_comp_c  = -1.0
deposit_comp_c = 0.0
deposit_comp_limit = 0.0
deposit_comp_c2 = 0.0
deposit_shape  = cic
deposit_max_level = 31
deposit_adaptive  = true
deposit_min_level = 0
deposit_ppc       = 2.0
deposit_max_coarsen = 31
alpha_exc      = 0.1
ah_exc_factor  = -1.0
hist_dcycle    = 1
cstat_dcycle   = 8
cons_dcycle    = 0
line_dcycle    = 0
traj_dcycle    = 16
traj_ntrack    = 0
snap_dt        = 10.0
probe_x1       = 0.001
probe_x2       = 0.001
probe_x3       = 0.001
nprobe         = 0
lambda         = 0.0
source_density = true
source_extrap  = true
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cosmo
id         = file
id_file    = fields.bin
hubble     = 1.0

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = tab
variable  = z4c
dt        = 0.5
slice_x2  = 0.001
slice_x3  = 0.001

<output3>
file_type = tab
variable  = con
dt        = 0.5
slice_x2  = 0.001
slice_x3  = 0.001

<output4>
file_type = tab
variable  = tmunu_E
dt        = 1.0
slice_x2  = 0.001
slice_x3  = 0.001

<output5>
file_type = tab
variable  = z4c_alpha
id        = alpha_y
dt        = 1.0
slice_x1  = 0.001
slice_x3  = 0.001

<output6>
file_type = tab
variable  = tmunu_E
id        = E_y
dt        = 1.0
slice_x1  = 0.001
slice_x3  = 0.001

<output7>
file_type = rst
dt        = 20.0

<output8>
file_type = tab
variable  = z4c_alpha
id        = alpha_z
dt        = 1.0
slice_x1  = 0.001
slice_x2  = 0.001

<output9>
file_type = tab
variable  = tmunu_E
id        = E_z
dt        = 1.0
slice_x1  = 0.001
slice_x2  = 0.001
