# Test F of tracks/B-emd-gw/waves: a linear gravitational wave with the oblique wave vector
# k = 2 pi (1, 1, 1) in the flat periodic box [-1/2, 1/2]^3, elliptic polarization (both
# polarizations with different amplitudes and a relative phase of 1 rad), over four
# periods. Problem generator z4c_linear_wave of core/requests-b (polarization tensor
# corrected; executable scratch/core/exe/core_requests-b, READY item 1):
#   gt_ij = delta_ij + amp e+_ij sin(P) + amp_cross ex_ij sin(P + phase_cross),
#   At_ij = pi |k| [amp e+_ij cos(P) + amp_cross ex_ij cos(P + phase_cross)],
#   P = 2 pi (k.x - |k| t),  k = (kx1, kx2, kx3) cycles per unit length.
# <time> tlim is read as a number of periods 1/|k| (generator). Numerics: the production
# configuration of the cosmology runs (nghost 4, RK4, Courant 0.25, Kreiss-Oliger 0.5,
# conformal-time lapse, zero shift, damp_kappa1 0.02), as problems/tests/lw_oblique.athinput
# of core/requests-b. Outputs: the Z4c variables in double precision every period/8.
# The mesh size is set on the command line (scripts/run_flat.sh).

<comment>
problem   = z4c linear wave, oblique wave vector, elliptic polarization

<job>
basename  = lwo

<mesh>
nghost    = 4
nx1       = 16
x1min     = -0.5
x1max     = 0.5
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 16
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 16
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 4.0       # periods
ndiag      = 100

<z4c>
lapse_oplog     = 0.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.3333333333333333
lapse_advect    = 0.0
shift_Gamma     = 0.0
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.5
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<problem>
pgen_name   = z4c_linear_wave
amp         = 1.0e-6
amp_cross   = 5.0e-7
phase_cross = 1.0
kx1         = 1.0
kx2         = 1.0
kx3         = 1.0

<output1>
file_type        = bin
variable         = z4c
double_precision = true
dt               = 0.07216878364870322   # period / 8 = 1/(8 sqrt 3)

<output2>
file_type   = hst
data_format = %.16e
dt          = 0.07216878364870322
