# Halo-population box of Track B (package population), full relativity: the first science-
# style scouting run of DESIGN.md section 8 ("scouting of the scan", 128^3, L = 8, one
# particle per cell, to a = 143). Same physics as pop_gr.athinput (production configuration
# of cosmo/README.md, conformal-time lapse, zero shift, no lapse_leak); added: tlim for
# a = 143 (t = 2 (sqrt(143) - 1) = 21.916), double-precision Z4c dumps every 0.25 in t for
# the GW analysis (gw_diag), particle snapshots every 1.0 for the halo finder, restart files
# every 2.0 for scripts/submit_chain.sh. Mesh, box and file paths on the command line.

<comment>
problem   = Track B population: Gaussian random field, full relativity, scouting run to a = 143

<job>
basename  = pop

<mesh>
nghost    = 4
nx1       = 32
x1min     = 0.0
x1max     = 4.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = 0.0
x2max     = 4.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 32
x3min     = 0.0
x3max     = 4.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 21.916
ndiag      = 1000

<z4c>
lapse_oplog     = 0.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.3333333333333333   # d_t alpha = -(1/3) alpha^2 K
lapse_volume    = 0.0                  # 1/3 (with lapse_harmonic = 0): alpha - gamma^(1/6) constant
lapse_advect    = 0.0
shift_Gamma     = 0.0                  # zero shift
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.5
damp_kappa1     = 0.5 
damp_kappa1_over_alpha = true          # damping rate kappa1 per unit of conformal time (a constant
                                       # coefficient becomes stiff when the lapse reaches 1000)
damp_kappa2     = 0.0
damp_kappa_gam  = 0.0                  # additional damping of the connection constraint alone
damp_ch         = 0.0
damp_ch_dx      = 0.0
damp_ch_chipow  = 0.0                  # exponent of chi in the relaxation of the Hamiltonian constraint (0: fixed diffusion coefficient in conformal time)
excise_chi      = 0.0                  # constraint norms over the whole box (chi = 1/a^2 falls)

<particles>
particle_type  = nrpic
pusher         = midpoint
interp         = bspline  # metric at the particles: hermite (Catmull-Rom) or bspline (cubic spline through the nodes)
dt_expansion   = 0.01    # > 0: step limited to this fraction of the expansion time
metric         = mesh
tolerance      = 1.0e-12
max_iterations = 50
deposit        = true
nfilter        = 0
filter_compensate = false
filter_comp_c  = -1.0
deposit_comp_c = 0.16666666666666666    # > 0: compensation of the cloud on the deposited density (1/12, 1/8, 1/6)
deposit_comp_limit = 0.0  # > 0: that pass limited where neighbouring cells differ strongly
deposit_comp_c2 = 0.4666666666666667     # fourth-order term of that pass (8/45, 37/120, 7/15)
deposit_shape  = pcs     # cloud shape: cic, tsc or pcs (B-spline of degree 1, 2, 3)
deposit_max_level = 31
deposit_adaptive  = false
deposit_min_level = 0
deposit_ppc       = 2.0
deposit_max_coarsen = 31
alpha_exc      = -1.0
ah_exc_factor  = -1.0
hist_dcycle    = 16
cstat_dcycle   = 16       # constraint statistics (maximum and mean, absolute and relative)
cons_dcycle    = 0        # conservation of the deposited matter on the mesh (cycles between records)
line_dcycle    = 0 
field_time1    = 1.0e30
field_time2    = 1.0e30
field_time3    = 1.0e30
field_time4    = 1.0e30
field_constraints = false   # field dumps also hold the constraints, Khat, Theta, lapse
traj_dcycle    = 0        # trajectories of the fiducial observers (lowest tags)
traj_ntrack    = 0
snap_dt        = 1.0
probe_x1       = 1.0
probe_x2       = 1.0
probe_x3       = 1.0
nprobe         = 1
probe1_x1      = 2.0
probe1_x2      = 2.0
probe1_x3      = 2.0
lambda         = 0.0
source_density = true    # densities converted with the volume element of each stage
source_extrap  = true    # ... extrapolated to the middle of the step
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cosmo
id         = file
id_file    = fields.bin
hubble     = 1.0

<output1>
file_type = hst
dt        = 0.5

<output2>
file_type   = bin
variable    = z4c
id          = z4cd
dt          = 0.25
ghost_zones = false
double_precision = true

<output3>
file_type = rst
dt        = 2.0
