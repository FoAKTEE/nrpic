# Plane-wave pancake in the Newtonian mode of the particle module (Track B, newton_tests):
# periodic box of side L = 1, comoving coordinates, conformal time t, a = (1 + t/2)^2
# (H = 1 at t = 0, where a = 1), lap Phi = 4 pi (rho - <rho>) with G = 1. Numerics of
# the Newtonian reference cosmo/newton/pm.py in the verify_cosmo pancake
# (tracks/B-emd-gw/verify_cosmo/scripts/newton_pancake.py): cubic cloud (pcs), cloud
# compensation c = 1/6, c2 = 7/15, no filter, cubic-spline interpolation, step a quarter
# cell. The mesh size, the step, the number of tracked particles and the end time are set
# on the command line by scripts/run_case.sh. Options: coord/INTERFACES/newtonian_mode.md.

<comment>
problem   = Track B newton_tests: plane-wave pancake, Newtonian mode, periodic, expanding

<job>
basename  = newton

<mesh>
nghost    = 4             # interp = bspline needs four
nx1       = 32
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 32
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk2          # not used by the particles; the driver needs one
cfl_number = 1.0
nlim       = -1
tlim       = 10.96148     # a = 42
ndiag      = 200

<gravity>
four_pi_G      = 12.566370614359172   # G = 1
threshold      = 0.0      # V cycles until the defect stops falling
niteration     = -1
npresmooth     = 1
npostsmooth    = 1
full_multigrid = false
fmg_ncycle     = 1
show_defect    = 0
mg_nghost      = 1
root_on_host   = false

<particles>
particle_type  = nrpic
pusher         = newton
interp         = bspline
dt             = 0.0078125  # L/(4 n) at n = 32
newton_cfl     = 0.0
newton_mg_tol  = 0.0
newton_expansion = power
newton_hubble  = 1.0
newton_exponent = 2.0
deposit        = true
deposit_shape  = pcs
nfilter        = 0
filter_compensate = false
filter_comp_c  = -1.0
deposit_comp_c = 0.16666666666666666
deposit_comp_limit = 0.0
deposit_comp_c2 = 0.4666666666666667
hist_dcycle    = 2
traj_dcycle    = 2
traj_ntrack    = 32
snap_dt        = 2.0
probe_x1       = 0.25     # crest of the east wave (largest density at a = 1)
probe_x2       = 0.5
probe_x3       = 0.5
nprobe         = 1
probe1_x1      = 0.75
probe1_x2      = 0.5
probe1_x3      = 0.5
particle_file  = particles.nrp

<problem>
pgen_name = nrpic_newton

<output1>
file_type = rst
dt        = 1.0e30
