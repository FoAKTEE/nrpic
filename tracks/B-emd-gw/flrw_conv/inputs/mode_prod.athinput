# flrw_conv leg B: test B of Daverio, Dirian & Mitsou (arXiv:1904.07841, Sec. 4.2):
# plane wave delta_* = A sin(2 pi x / L), A = 1e-7, L = 128 Mpc/h = 1.35085 initial
# Hubble radii, from a = 1 (z = 1000) to a = 1001 (t = 61.277), in the production
# configuration of cosmo/README.md, with the step limit 0.002 of the expansion time
# (instead of 0.01) so that the background step does not mask the mesh error
# (tracks/B-emd-gw/verify_cosmo/VERIFY.md section 2; cosmo/TESTLOG.md lines 1883-1903).
# Initial data: cosmo/ic/make_east.py --delta 1e-7 --ratios 1,0,0 --L 1.35085 (cubic
# cloud with the same compensation), given on the command line as
# particles/particle_file=<ic dir>/particles.nrp problem/id_file=<ic dir>/fields.bin.
# Derived from problems/cosmo/daverio_mode.athinput (production options written in;
# line records every 16 steps for the growth rate).

<comment>
problem   = single plane wave in an expanding universe, production configuration

<job>
basename  = east

<mesh>
nghost    = 4
nx1       = 32
x1min     = 0.0
x1max     = 1.35085
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = 0.0
x2max     = 1.35085
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 32
x3min     = 0.0
x3max     = 1.35085
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 61.277
ndiag      = 1000

<z4c>
lapse_oplog     = 0.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.3333333333333333   # d_t alpha = -(1/3) alpha^2 K
lapse_volume    = 0.0
lapse_advect    = 0.0
shift_Gamma     = 0.0                  # zero shift
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.5
damp_kappa1     = 0.5                  # production: damping rate 0.5 ...
damp_kappa1_over_alpha = true          # ... per unit of conformal time
damp_kappa2     = 0.0
damp_kappa_gam  = 0.0
damp_ch         = 0.0
damp_ch_dx      = 0.0
damp_ch_chipow  = 0.0
excise_chi      = 0.0                  # constraint norms over the whole box

<particles>
particle_type  = nrpic
pusher         = midpoint
interp         = bspline  # production: cubic spline through the cell values
dt_expansion   = 0.002    # step limit 0.002 of the expansion time (production: 0.01)
metric         = mesh
tolerance      = 1.0e-12
max_iterations = 50
deposit        = true
nfilter        = 0
filter_compensate = false
filter_comp_c  = -1.0
deposit_comp_c = 0.16666666666666666   # production: compensation of the cubic cloud
deposit_comp_limit = 0.0
deposit_comp_c2 = 0.4666666666666667   # ... to fourth order
deposit_shape  = pcs      # production: cubic cloud
deposit_max_level = 31
deposit_adaptive  = false
deposit_min_level = 0
deposit_ppc       = 2.0
deposit_max_coarsen = 31
alpha_exc      = -1.0
ah_exc_factor  = -1.0
hist_dcycle    = 8
cstat_dcycle   = 8        # constraint statistics (maximum and mean, absolute and relative)
cons_dcycle    = 0
line_dcycle    = 16       # records of chi, alpha, K, E, S_x along the first x1 line
traj_dcycle    = 0
traj_ntrack    = 94
snap_dt        = 100.0
probe_x1       = 0.3377125
probe_x2       = 0.3377125
probe_x3       = 0.3377125
nprobe         = 1
probe1_x1      = 1.0131375
probe1_x2      = 0.3377125
probe1_x3      = 0.3377125
lambda         = 0.0
source_density = true     # densities converted with the volume element of each stage
source_extrap  = true     # ... extrapolated to the middle of the step
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cosmo
id         = file
id_file    = fields.bin
hubble     = 1.0

<output1>
file_type = hst
dt        = 0.5
