# Vacuum periodic box started from a file of the nrpic_cosmo problem generator
# (athenak/src/pgen/nrpic/nrpic_cosmo.cpp, <problem> id = file): the gauge-wave test of
# the Apples-with-Apples suite and the pure-gauge data of the record of the lapse and
# shift options (B-pre-1, periodic_z4c). The file (analysis/make_ids.py) gives psi, K,
# alpha, Ahat_ij per cell; no <particles> block, so the run is vacuum.
# Thin box: x2, x3 have 4 cells of the size of the x1 cells (set on the command line:
# mesh/nx1, mesh/x1max, mesh/x2max, mesh/x3max, meshblock/nx1, slices).
# Production numerics of the cosmology runs: nghost 4, RK4, Courant 0.25, KO 0.5,
# damp_kappa1 0.02. The gauge is set on the command line for every case.

<comment>
problem   = vacuum periodic box from a file of nrpic_cosmo

<job>
basename  = gauge

<mesh>
nghost    = 4
nx1       = 64
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 4
x2min     = 0.0
x2max     = 0.0625
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 4
x3min     = 0.0
x3max     = 0.0625
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 4
nx3       = 4

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 10.0
ndiag      = 1000

<z4c>
lapse_oplog     = 0.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.3333333333333333
lapse_volume    = 0.0
lapse_kdriver   = 0.0
lapse_advect    = 0.0
shift_Gamma     = 0.0
shift_alpha2Gamma = 0.0
shift_H         = 0.0
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
excise_chi      = 0.0

<problem>
pgen_name = nrpic_cosmo
id        = file
id_file   = id.bin
hubble    = 0.0

<output1>
file_type   = tab
variable    = z4c
data_format = %.16e
dt          = 0.0625
slice_x2    = 0.0234375
slice_x3    = 0.0234375
ghost_zones = false

<output2>
file_type   = tab
variable    = con
data_format = %.16e
dt          = 0.0625
slice_x2    = 0.0234375
slice_x3    = 0.0234375
ghost_zones = false

<output3>
file_type   = hst
data_format = %.16e
dt          = 0.0625
