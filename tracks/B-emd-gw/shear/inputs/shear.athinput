# Shearing-dust test of Adamek et al. (arXiv:2003.08014, draft.tex:142-182) with NRPIC
# particles (tracks/B-emd-gw/shear/SPEC.md). Thin periodic box [-L/2, L/2]^3 with the
# variation along y only: 4 cells in x and z (core/requests-b READY item 4), N_y cells in y.
# Units G = c = 1, H_* = 1 at a = 1, so L = H_* L. Lapse d_t alpha = -(1/3) alpha^2 K
# (lapse_harmonic = 1/3; = 1 for the literal harmonic slicing leg) and zero shift; with
# 1/3, t is conformal time and a = (1 + t/2)^2 on the background.
# Initial slice (nrpic_cosmo, id = file, scripts/make_shear_ic.py): psi = 1, K = -3,
# alpha = 1, Ahat_xy = (3b/(4L)) cos(2 pi y/L); dust on a lattice with masses D(y) dV and
# u_x = u*^x(y); tracers and two fans of light rays from O at t = 0 (tags below
# traj_ntrack). Production numerics of cosmo/README.md: pcs clouds with compensation 1/6
# and 7/15, bspline metric, step limit 0.01 of the expansion time, damping 0.5 per unit
# conformal time, nghost 4, RK4, Courant 0.25, KO 0.5.
# Mesh size, box, tlim, traj_ntrack and the file paths are set on the command line
# (scripts/run_cases.py).

<comment>
problem   = shearing dust (frame dragging) in a matter-dominated universe

<job>
basename  = shear

<mesh>
nghost    = 4
nx1       = 4
x1min     = -0.5
x1max     = 0.5
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 4
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 4
nx2       = 32
nx3       = 4

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 1.5
ndiag      = 100

<z4c>
lapse_oplog     = 0.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.3333333333333333   # d_t alpha = -(1/3) alpha^2 K
lapse_volume    = 0.0
lapse_kdriver   = 0.0
lapse_advect    = 0.0
shift_Gamma     = 0.0                  # zero shift
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.5
damp_kappa1     = 0.5
damp_kappa1_over_alpha = true
damp_kappa2     = 0.0
damp_kappa_gam  = 0.0
damp_ch         = 0.0
damp_ch_dx      = 0.0
damp_ch_chipow  = 0.0
excise_chi      = 0.0

<particles>
particle_type  = nrpic
pusher         = midpoint
interp         = bspline
dt_expansion   = 0.01
metric         = mesh
tolerance      = 1.0e-12
max_iterations = 50
deposit        = true
nfilter        = 0
filter_compensate = false
filter_comp_c  = -1.0
deposit_comp_c = 0.16666666666666666
deposit_comp_limit = 0.0
deposit_comp_c2 = 0.4666666666666667
deposit_shape  = pcs
deposit_max_level = 31
deposit_adaptive  = false
deposit_min_level = 0
deposit_ppc       = 1.0
deposit_max_coarsen = 31
alpha_exc      = -1.0
ah_exc_factor  = -1.0
hist_dcycle    = 1
cstat_dcycle   = 4
cons_dcycle    = 0
line_dcycle    = 0
traj_dcycle    = 1
traj_ntrack    = 23
snap_dt        = 1000.0
probe_x1       = 0.0
probe_x2       = 0.0
probe_x3       = 0.0
nprobe         = 1
lambda         = 0.0
source_density = true
source_extrap  = true
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cosmo
id         = file
id_file    = fields.bin
hubble     = 1.0

<output1>
file_type = hst
dt        = 0.01
