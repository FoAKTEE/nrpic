# Secondary infall onto a compact clump (the stand-in for the hole) in AthenaK's Newtonian
# mode, isolated domain (coord/INTERFACES/newtonian_mode.md; problems/newton/isolated.athinput
# is the template). Units G = 1, M = 1. a = 1: physical coordinates, code time = cosmic
# time - t_i. The mesh, box, step, end time, snapshot interval and particle file are set
# on the command line by nm_run.py (every option the runs change is listed here).

<comment>
problem   = secondary infall, Newtonian mode, isolated domain (D-bh-dress)

<job>
basename  = infall

<mesh>
nghost    = 2
nx1       = 128
x1min     = -68.0
x1max     = 68.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 128
x2min     = -68.0
x2max     = 68.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 128
x3min     = -68.0
x3max     = 68.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 64
nx2       = 64
nx3       = 64

<time>
evolution  = dynamic
integrator = rk2          # not used by the particles; the driver needs one
cfl_number = 1.0
nlim       = -1
tlim       = 155.55555555555554
ndiag      = 100

<gravity>
four_pi_G      = 12.566370614359172   # G = 1
threshold      = 0.0      # 0: V cycles until the defect stops falling (or newton_mg_tol)
niteration     = -1
npresmooth     = 1
npostsmooth    = 1
full_multigrid = false    # start from the potential of the previous step
fmg_ncycle     = 1
show_defect    = 0
mg_nghost      = 1
mg_bc          = multipole   # isolated domain
mporder        = 4
auto_mporigin  = true
root_on_host   = false

<particles>
particle_type  = nrpic
pusher         = newton
interp         = hermite
dt             = 0.25      # upper limit of the step
newton_cfl     = 0.15      # step <= c dx/max|p| and <= sqrt(2 c dx/max|g|)
newton_mg_tol  = 1.0e-6    # Poisson solve ends at this fraction of the source norm
newton_expansion = none
newton_hubble  = 0.0
newton_exponent = 2.0
deposit        = true
deposit_shape  = cic
nfilter        = 0
filter_compensate = false
filter_comp_c  = -1.0
deposit_comp_c = 0.0
deposit_comp_limit = 0.0
deposit_comp_c2 = 0.0
hist_dcycle    = 10
traj_dcycle    = 0
traj_ntrack    = 0
snap_dt        = 3.111111111111111
probe_x1       = 0.0
probe_x2       = 0.0
probe_x3       = 0.0
nprobe         = 2
probe1_x1      = 4.0
probe1_x2      = 0.0
probe1_x3      = 0.0
probe2_x1      = 16.0
probe2_x2      = 0.0
probe2_x3      = 0.0
particle_file  = particles.nrp

<problem>
pgen_name = nrpic_newton

<output1>
file_type = rst
dt        = 1.0e30
