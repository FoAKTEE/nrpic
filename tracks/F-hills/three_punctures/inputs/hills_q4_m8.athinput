# Cheaper Hills passage, q = 4: M = 1, m1 = m2 = 0.125, a_b = 5, r_p = 9.82
# (D = 1.24), coplanar prograde, binary phase 127 deg, start at 4 r_t = 31.75.
# Positions and momenta: newton3 driver from 10 r_t read at 4 r_t
# (run F-hills-20261115-131832-907e5fe). Members at m/8 (cells 0.015625, level 9),
# heavy hole at M/8 (level 6). Wave zone: cells 2 within 48, 4 within 100.
# Cost: 15 card-hours for 270 M (run F-hills-20261115-131933-907e5fe).
# Needs core/multi-puncture.

<comment>
problem   = Hills passage, q4_ab5_rp9.8 (proposal of tracks/F-hills/three_punctures; not run)

<job>
basename  = hills

<mesh>
nghost    = 4
nx1       = 64
x1min     = -256.0
x1max     = 256.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -256.0
x2max     = 256.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -256.0
x3max     = 256.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement          = adaptive
num_levels          = 10
max_nmb_per_rank    = 2700      # T3b: at most 2332 (q = 10) / 2080 (q = 4) at m/8; check the card memory
ncycle_check        = 4
refinement_interval = 8

<z4c_amr>
method            = tracker
radius_0_rad      = 48.0
radius_0_reflevel = 2
radius_1_rad      = 100.0
radius_1_reflevel = 1

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 280.0
ndiag      = 100

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0       # eta M = 2 for the heavy hole, eta m = 0.25 for a member
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
tracker_mode    = ode
nrad_wave_extraction = 4
extraction_radius_0  = 40.0
extraction_radius_1  = 48.0
extraction_radius_2  = 70.0
extraction_radius_3  = 90.0
extraction_nlev      = 10
waveform_dt          = 0.25

<problem>
pgen_name       = nrpic_cf
ncomp           = 3
comp0_type      = puncture
comp0_mass      = 0.125
comp0_x1        = -7.8694832795
comp0_x2        = -21.7944554502
comp0_x3        = 0.0
comp0_p1        = 0.0134969953
comp0_p2        = 0.0259652475
comp0_p3        = 0.0
comp0_corr      = approx
comp1_type      = puncture
comp1_mass      = 0.125
comp1_x1        = -11.4963685661
comp1_x2        = -25.1659740897
comp1_x3        = 0.0
comp1_p1        = 0.0331350977
comp1_p2        = 0.0052828910
comp1_p3        = 0.0
comp1_corr      = approx
comp2_type      = puncture
comp2_mass      = 1
comp2_x1        = 2.4207314807
comp2_x2        = 5.8700536925
comp2_x3        = 0.0
comp2_p1        = -0.0466320930
comp2_p2        = -0.0312481385
comp2_p3        = 0.0
comp2_corr      = approx
corr_background = true
lapse           = precollapsed
puncture_setup  = true
puncture_radius = 1.8

<output1>
file_type = hst
dt        = 0.5

<output2>
file_type = bin
variable  = z4c_alpha
slice_x3  = 0.001
dt        = 10.0

<output3>
file_type = bin
variable  = con_H
slice_x3  = 0.001
dt        = 10.0

<output4>
file_type = rst
dt        = 5.0

# full fields once at the start, for the constraint check of the data (run R0)
<output5>
file_type = bin
variable  = con
dt        = 1.0e6

<output6>
file_type = bin
variable  = adm_psi4
dt        = 1.0e6
