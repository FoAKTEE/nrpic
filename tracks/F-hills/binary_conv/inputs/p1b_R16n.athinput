# Passage P1b of F-hills (binary_conv, wave 3 batch 3): P1 with the members at m/16 (R16n).
# Written by tracks/F-hills/binary_conv/scripts/make_p1b.py from tracks/F-hills/nr_first/inputs/p1_q4.athinput;
# only <comment>, the root cells (nx = 64), num_levels (11) and max_nmb_per_rank (3000) differ.
# Data, gauge (constant shift_eta = 2), extraction, outputs and tlim 280 are P1's.
# Chain it with tracks/F-hills/binary_conv/scripts/athena_keep_trackers_bc.sh (binary_conv README, P1b).

<comment>
problem   = Hills passage P1b, q = 4, a_b = 5, r_p = 9.8, members m/16 (binary_conv; prepared, not submitted)

<job>
basename  = hills

<mesh>
nghost    = 4
nx1       = 64
x1min     = -256.0
x1max     = 256.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -256.0
x2max     = 256.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -256.0
x3max     = 256.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement          = adaptive
num_levels          = 11
max_nmb_per_rank    = 3000
ncycle_check        = 4
refinement_interval = 8

<z4c_amr>
method            = tracker
radius_0_rad      = 48.0
radius_0_reflevel = 2
radius_1_rad      = 100.0
radius_1_reflevel = 1

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 280.0
ndiag      = 100

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0       # eta M = 2 for the heavy hole, eta m = 0.25 for a member
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
tracker_mode    = ode
nrad_wave_extraction = 4
extraction_radius_0  = 40.0
extraction_radius_1  = 48.0
extraction_radius_2  = 70.0
extraction_radius_3  = 90.0
extraction_nlev      = 10
waveform_dt          = 0.25

<problem>
pgen_name       = nrpic_cf
ncomp           = 3
comp0_type      = puncture
comp0_mass      = 0.125
comp0_x1        = -7.8694832795
comp0_x2        = -21.7944554502
comp0_x3        = 0.0
comp0_p1        = 0.0134969953
comp0_p2        = 0.0259652475
comp0_p3        = 0.0
comp0_corr      = approx
comp1_type      = puncture
comp1_mass      = 0.125
comp1_x1        = -11.4963685661
comp1_x2        = -25.1659740897
comp1_x3        = 0.0
comp1_p1        = 0.0331350977
comp1_p2        = 0.0052828910
comp1_p3        = 0.0
comp1_corr      = approx
comp2_type      = puncture
comp2_mass      = 1
comp2_x1        = 2.4207314807
comp2_x2        = 5.8700536925
comp2_x3        = 0.0
comp2_p1        = -0.0466320930
comp2_p2        = -0.0312481385
comp2_p3        = 0.0
comp2_corr      = approx
corr_background = true
lapse           = precollapsed
puncture_setup  = true
puncture_radius = 1.8

<output1>
file_type = hst
dt        = 0.5

<output2>
file_type = bin
variable  = z4c_alpha
slice_x3  = 0.001
dt        = 10.0

<output3>
file_type = bin
variable  = con_H
slice_x3  = 0.001
dt        = 10.0

<output4>
file_type = rst
dt        = 5.0

# full fields once at the start
<output5>
file_type = bin
variable  = con
dt        = 1.0e6

<output6>
file_type = bin
variable  = adm_psi4
dt        = 1.0e6
