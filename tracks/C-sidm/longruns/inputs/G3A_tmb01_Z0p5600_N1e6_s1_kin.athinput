# longruns G3A_tmb01_Z0p5600_N1e6_s1_kin (G3 step 1a, make_decks_g3a.py; scope/SCOPE_G3.md section 2a): the deck of
# A8N_y0p32400_N1e6_s1_kin (G2 member N6b324) with the b = 0.1 model tmb01_Z0p5600 (kicked 1 percent inward) and the finder of core-v0.8.
# longruns A8N_y0p32400_N1e6_s1_kin (batch 17, make_decks_b17.py): the deck of A8N_y0p33403_N1e6_s1_ctrl for the
# model king_y0p32400 at N = 1e6, kicked one percent inward (particle file king_y0p32400_stratified_N1000000_s1_kin.nrp).
# longruns A8N_y0p33403_N1e6_s1_ctrl: N-series of the M/8 control drift (batch 11), King b = 1 king_y0p33403,
# stratified sample seed 1 at N = 1000000, unkicked control, collisionless, 600 M;
# otherwise the block A deck A8_y0p33403_s1_ctrl (N = 1e5).
# Written by tracks/C-sidm/longruns/scripts/make_decks_b11.py; do not edit by hand.

<comment>
problem          = F21 b = 0.1 thermal core G3A_tmb01_Z0p5600_N1e6_s1_kin

<job>
basename         = cc
rng_seed         = 1

<mesh>
nghost    = 4
nx1       = 64
x1min     = -512.0
x1max     = 512.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -512.0
x2max     = 512.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -512.0
x3max     = 512.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement       = static
max_nmb_per_rank = 1024

<refined_region1>
level = 6
x1min = -7.9
x1max = 7.9
x2min = -7.9
x2max = 7.9
x3min = -7.9
x3max = 7.9

<refined_region2>
level = 7          # drift package: cells of M/8 inside |x|_inf < 3.9 M (SCAN.md block B, mesh leg)
x1min = -3.9
x1max = 3.9
x2min = -3.9
x2max = 3.9
x3min = -3.9
x3max = 3.9

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim             = 600
ndiag            = 1600

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
damp_ch         = 0.0      # parabolic relaxation of the Hamiltonian constraint (length); 0: off
damp_ch_dx      = 0.0      # part of it proportional to the local cell size

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-7
max_iterations = 50
deposit        = true
nfilter        = 4
filter_compensate = true   # cancels the widening of the binomial passes (plain passes soften the self-gravity)
filter_comp_c  = -1.0          # its coefficient; negative: nfilter/4
deposit_max_level = 31
deposit_adaptive  = false
deposit_min_level = 6
deposit_ppc       = 2.0
deposit_max_coarsen = 31   # a cloud is at most this many levels coarser than its particle's block
alpha_exc      = 0.1
hist_dcycle      = 8   # every 0.25 M at dt = M/32
snap_dt          = 10.0
particle_file    = /data/haiyangw/nrpic/scratch/C-sidm/C-20261128-020724-14139b1/s1/tmb01_Z0p5600_stratified_N1000000_s1_kin.nrp
cstat_dcycle     = 32
traj_dcycle      = 800   # every 25 M at dt = M/32
traj_ntrack      = 100000   # the first 1e5 particles

<problem>
pgen_name  = nrpic_cf
ncomp      = 1
comp0_type = table
comp0_file       = /data/haiyangw/nrpic/scratch/C-sidm/C-20261128-020724-14139b1/s1/tmb01_Z0p5600_stratified_N1000000_s1.tab
lapse      = table

<fastflow>
num_horizons        = 1         # 0 when absent: no finder (z4c/z4c.cpp:286)
find_every          = 32        # every 1 M at dt = M/32
flow                = shear     # z4c/fastflow.cpp:68; finds horizons of any mass from any start radius (decision 0048)
mass_tol_0          = 1.0e-5    # the mass rule (core-v0.8 READY)
flow_iterations_0   = 400
polish_iterations_0 = 100
initial_radius_0    = 1.0
diagnostics         = true      # cc.horizon_status_0.txt: found or not, reason, iterations

<output1>
file_type = hst
dt        = 1.0

<output2>
file_type = rst
dt               = 10
