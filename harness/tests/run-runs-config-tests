#!/bin/bash
# Runs the self-tests of nrpic-run, nrpic-env, nrpic-stage, the vendored figure libraries, the
# proposed hooks and the proposed Claude Code configuration. Each builds its own scratch
# repository under <main checkout>/scratch/harness/ and never touches live branches or worktrees.
#   harness/tests/run-runs-config-tests [--full]     (--full: the dummy run of test_nrpic_run lasts 30 s)
# Exit status: number of test files that failed.
set -u
PATH=/usr/local/bin:/usr/bin:/bin
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
fail=0
for t in test_nrpic_env.py test_nrpic_run.py test_style.py test_nrpic_stage.py test_hooks.py test_claude_config.py; do
  args=()
  [[ $t == test_nrpic_run.py && ${1:-} == --full ]] && args=(--full)
  line=$(/usr/bin/python3 -I "$here/$t" "${args[@]}" 2>&1 | tee /dev/stderr | grep -E '^== .*: [0-9]+/[0-9]+ passed' | tail -1)
  echo "$t: ${line:-no summary (crashed?)}"
  [[ $line =~ :\ ([0-9]+)/([0-9]+)\ passed ]] && [[ ${BASH_REMATCH[1]} == "${BASH_REMATCH[2]}" ]] || fail=$((fail + 1))
done 2>/dev/null
echo "runs+config self-tests: $fail file(s) with failures"
exit $fail
