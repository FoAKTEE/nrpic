#!/usr/bin/python3 -I
"""git pre-commit hook of the program (brief 13.1): rejects a commit that

  1. adds or changes a file above 5 MB;
  2. adds a line that looks like a secret (private key block, cloud or chat token, an API key
     assignment);
  3. adds a run manifest tracks/<ID>/runs/<run_id>/manifest.json that is not a JSON object, whose
     run_id differs from its directory or is not <owner>-<YYYYMMDD-HHMMSS>-<commit7> (decision
     0012; a hand-written manifest with other field names or status words is accepted and noted);
  4. on an owner's branch, touches a path outside tracks/<ID>/ and the globs of that owner's
     OWNERSHIP (main's copy; the branch's own if main has none). Merge commits, proposal/<ID>/<slug>
     branches and main itself are exempt from this check.

Installed for every worktree with `git config core.hooksPath <main checkout>/harness/hooks`
(decision 0008: not installed until the user confirms). It reads the index git names in
GIT_INDEX_FILE (path-limited commits use a temporary one) and nothing else from the environment.
Exit 1 with the reasons on standard error; there is no bypass (--no-verify is denied by the guard).
"""
import fnmatch
import json
import os
import re
import subprocess
import sys

LIMIT = 5 * 1024 * 1024
TRACKS = ("A-emd-pbh", "B-emd-gw", "C-sidm", "D-bh-dress", "E-stoch-inf", "F-hills")
SECRETS = [
    (re.compile(r"-----BEGIN (?:RSA |DSA |EC |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----"), "a private key block"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "an AWS access key id"),
    (re.compile(r"aws_secret_access_key\s*[=:]\s*['\"]?[A-Za-z0-9/+]{30,}"), "an AWS secret key"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}\b"), "a GitHub token"),
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{40,}\b"), "a GitHub token"),
    (re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}\b"), "a Slack token"),
    (re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}\b"), "an Anthropic API key"),
    (re.compile(r"\bsk-[A-Za-z0-9]{32,}\b"), "an API secret key"),
    (re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b"), "a Google API key"),
    (re.compile(r"(?i)\b(?:api[_-]?key|secret[_-]?key|access[_-]?token|password)\s*[=:]\s*['\"][A-Za-z0-9/+_=-]{20,}['\"]"),
     "a key or password assignment"),
]
RUN_ID = re.compile(r"^([A-Za-z][A-Za-z0-9-]*?)-(\d{8})-(\d{6})-([0-9a-f]{7,40})$")
GIT_KEEP = ("GIT_DIR", "GIT_INDEX_FILE", "GIT_WORK_TREE", "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR",
            "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_QUARANTINE_PATH")


def env():
    e = {"PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8", "HOME": os.path.expanduser("~")}
    for k in GIT_KEEP:                       # set by git for its hooks: the index being committed
        if k in os.environ:
            e[k] = os.environ[k]
    return e


def git(*args, check=True, binary=False):
    r = subprocess.run(["git"] + list(args), capture_output=True, env=env())
    if check and r.returncode != 0:
        sys.stderr.write(r.stderr.decode(errors="replace"))
        sys.exit(1)
    return r.stdout if binary else r.stdout.decode(errors="replace")


def owner_of(branch):
    if branch.startswith("track/"):
        return branch[6:].split("--", 1)[0]
    if branch.startswith("core/"):
        return "core"
    if branch.startswith("kb/"):
        return "kb"
    return None


def ownership(owner):
    for rev in ("main", "HEAD"):
        r = subprocess.run(["git", "show", f"{rev}:tracks/{owner}/OWNERSHIP"], capture_output=True, env=env())
        if r.returncode == 0:
            return [l.split("#", 1)[0].strip() for l in r.stdout.decode(errors="replace").splitlines()
                    if l.split("#", 1)[0].strip()]
    return []


def glob_match(rel, pattern):
    rx, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            rx, i = rx + "(?:.*/)?", i + 3
        elif pattern.startswith("**", i):
            rx, i = rx + ".*", i + 2
        elif pattern[i] == "*":
            rx, i = rx + "[^/]*", i + 1
        elif pattern[i] == "?":
            rx, i = rx + "[^/]", i + 1
        else:
            rx, i = rx + re.escape(pattern[i]), i + 1
    return re.fullmatch(rx, rel) is not None or fnmatch.fnmatch(rel, pattern)


def main():
    problems, notes = [], []
    staged = []
    out = git("diff", "--cached", "--name-status", "--no-renames", "-z")
    parts = [p for p in out.split("\0") if p != ""]
    for k in range(0, len(parts) - 1, 2):
        staged.append((parts[k][0], parts[k + 1]))
    if not staged:
        return 0
    branch = git("rev-parse", "--abbrev-ref", "HEAD", check=False).strip()
    top = git("rev-parse", "--show-toplevel").strip()
    gitdir = git("rev-parse", "--git-dir").strip()
    merging = os.path.exists(os.path.join(gitdir if os.path.isabs(gitdir) else os.path.join(top, gitdir), "MERGE_HEAD"))

    # 1. size
    for st, path in staged:
        if st in ("A", "M", "T"):
            size = git("cat-file", "-s", f":{path}", check=False).strip()
            if size.isdigit() and int(size) > LIMIT:
                problems.append(f"{path}: {int(size) / 2**20:.1f} MB, above the 5 MB limit (data stays in scratch/; "
                                "commit a small derived table or its checksum)")
    # 2. secrets, in the added lines only
    diff = git("diff", "--cached", "-U0", "--no-color", "--no-ext-diff", "--text")
    cur = None
    for line in diff.splitlines():
        if line.startswith("+++ "):
            cur = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("+") and not line.startswith("+++") and cur:
            for rx, what in SECRETS:
                if rx.search(line):
                    problems.append(f"{cur}: an added line looks like {what}; remove it (and rotate it if real)")
                    break
    # 3. run manifests
    for st, path in staged:
        m = re.fullmatch(r"tracks/([^/]+)/runs/([^/]+)/manifest\.json", path)
        if not m or st == "D":
            continue
        blob = git("show", f":{path}", check=False, binary=True)
        try:
            doc = json.loads(blob.decode("utf-8"))
        except (UnicodeDecodeError, ValueError) as e:
            problems.append(f"{path}: not JSON ({e})")
            continue
        if not isinstance(doc, dict):
            problems.append(f"{path}: not a JSON object")
            continue
        rid = doc.get("run_id")
        if rid != m.group(2):
            problems.append(f"{path}: run_id {rid!r} differs from its directory {m.group(2)!r}")
        elif not RUN_ID.match(rid):
            problems.append(f"{path}: run_id {rid!r} is not <owner>-<YYYYMMDD-HHMMSS>-<commit7> (decision 0012)")
        if doc.get("schema") != "nrpic-run-manifest/1":
            notes.append(f"{path}: hand-written manifest (accepted; `nrpic-run lint` shows how it is read)")
    # 4. foreign paths
    owner = owner_of(branch)
    if owner and not merging:
        globs = ownership(owner)
        for st, path in staged:
            if path.startswith(f"tracks/{owner}/") or any(glob_match(path, g) for g in globs):
                continue
            problems.append(f"{path}: outside tracks/{owner}/ and tracks/{owner}/OWNERSHIP; shared paths change "
                            f"through main or core (write a proposal into tracks/{owner}/outbox/)")
    for n in notes[:5]:
        sys.stderr.write(f"pre-commit: note: {n}\n")
    if problems:
        sys.stderr.write("pre-commit: commit rejected (harness/hooks/pre-commit, brief 13.1):\n")
        for p in problems[:40]:
            sys.stderr.write(f"  - {p}\n")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
