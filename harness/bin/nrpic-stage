#!/usr/bin/python3 -I
"""The automated steps of the stage check (brief section 13.3: steps 2, 3 and 8).

    harness/bin/nrpic-stage [-C <wt>] collect <ID> G<k> [--force]
    harness/bin/nrpic-stage [-C <wt>] verify  <ID> G<k> [--no-rerun] [--no-checksums] [--timeout S]
                                                  [--rtol R] [--atol A] [--img-tol T]
    harness/bin/nrpic-stage [-C <wt>] report  <ID> G<k> [--decision TEXT]

collect  writes tracks/<ID>/stage/G<k>/CHECKLIST.md: the common gate criteria and products of
         charter 9.2, the track-specific criteria of the track's sheet (charter 9.3-9.9; kb: brief
         12.10), the minimum figures of brief 13.4, and the package items of 13.3, one item each
         with `status: OPEN` and an empty `evidence:` for the session to fill (PASS, FAIL, NA).
         Run again, it keeps the status and evidence of items whose text is unchanged.
verify   exports the committed tip (HEAD of the own worktree; for another owner, the tip of its
         branch) with `git archive` into scratch/<me>/tmp/stage-verify/ (a clean checkout, no
         working-tree state), and there: re-runs every note/scripts/fig_*.py and schem_*.py and
         every command listed in stage/G<k>/VERIFY through `nrpic-env exec` (the worktree's venv),
         compares the regenerated tables (numbers within rtol/atol) and PNG figures (pixel rms
         within img-tol) with the committed ones, and requires every committed figure to be
         regenerated by its own script; checks that main is merged, the worktree is clean, every
         copy of czstyle.py/paperfig.py/cyclic_zoom.mplstyle/figstyle.py in note/scripts/ equals
         harness/style/SHA256SUMS, every figure has a script of the same name, every run manifest
         is complete and finished and its output checksums verify, no committed file exceeds 5 MB,
         the note exists. Writes VERIFY_RESULTS.json and VERIFY_RESULTS.md into the stage
         directory (own track) or beside the export (another owner's). Exit 1 on any FAIL.
report   writes tracks/<ID>/stage/G<k>/STAGE_REPORT.md from harness/templates/STAGE_REPORT.md:
         criterion-by-criterion results from CHECKLIST.md, the verify results, the figure list,
         null results and failed runs, open risks (RISKS.md), the verifier report, the decision
         requested. Verdict PASS only if every item is PASS or NA, verify passed on the current
         commit and VERIFIER_REPORT.md exists. It prints the tag name; tags are created and
         pushed by the orchestrator (decision 0003).
collect and report write only into the own track's stage directory; nothing is committed.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import nrpic_harness as H  # noqa: E402

LIB = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib")
BRIEF = "einstein_vlasov_pic_cosmology_agent_brief.en.md"
SHEET = {"core": r"### 9\.3 core\b", "kb": r"### 9\.10 "}
for _t in H.TRACK_IDS:
    SHEET[_t] = r"### 9\.\d+ Track " + _t[0] + r"\b"
DEFAULT_BRANCH = {"core": "core/nrpic", "kb": "kb/main"}
STYLE_FILES = ("czstyle.py", "paperfig.py", "cyclic_zoom.mplstyle", "figstyle.py")
FIG_EXT = (".pdf", ".png", ".svg", ".eps")
TEXT_EXT = (".csv", ".dat", ".txt", ".tex", ".json", ".md", ".tsv")
MIN_FIGS = {"G0": (2, 0), "G1": (2, 1), "G2": (1, 5), "G3": (1, 1), "G4": (1, 1)}   # (schematics, data)


# ------------------------------------------------------------------ helpers

def read_shared(wt, rel):
    p = os.path.join(wt.root, rel)
    if os.path.isfile(p):
        return open(p).read()
    r = H.run(["git", "-C", wt.root, "show", f"main:{rel}"], check=False)
    if r.returncode != 0:
        raise H.HarnessError(f"{rel} is neither in {wt.root} nor on main")
    return r.stdout


def section(text, heading_rx):
    lines = text.splitlines()
    for i, l in enumerate(lines):
        if re.match(heading_rx, l):
            level = len(l) - len(l.lstrip("#"))
            out = []
            for l2 in lines[i + 1:]:
                if l2.startswith("#") and len(l2) - len(l2.lstrip("#")) <= level and l2.lstrip("#").startswith(" "):
                    break
                if l2.strip() == "---":
                    break
                out.append(l2)
            return l.lstrip("# ").strip(), "\n".join(out)
    return None, None


def table_row(text, first_cell):
    for l in text.splitlines():
        cells = [c.strip() for c in l.strip().strip("|").split("|")]
        if l.strip().startswith("|") and cells and cells[0] == first_cell:
            return cells
    return None


def split_items(s):
    s = s.strip().rstrip(".")
    out, depth, cur = [], 0, ""
    for ch in s:
        depth += ch == "("
        depth -= ch == ")"
        if ch == ";" and depth == 0:
            out.append(cur.strip())
            cur = ""
        else:
            cur += ch
    if cur.strip():
        out.append(cur.strip())
    return [x[0].upper() + x[1:] if x else x for x in out]


def track_criteria(sheet_text, gate):
    m = re.search(r"\*\*Track-specific criteria\.\*\*\s*(.*?)(?:\n\s*\n|\Z)", sheet_text, re.S)
    if not m:
        return []
    parts = re.split(r"\b(G\d)(?: \([^)]*\))?:\s+", " ".join(m.group(1).split()))
    crit = {}
    for k in range(1, len(parts) - 1, 2):
        crit[parts[k]] = parts[k + 1]
    return split_items(crit[gate]) if gate in crit else []


def owner_branch(wt, owner):
    if owner == wt.owner:
        return wt.branch
    pref = DEFAULT_BRANCH.get(owner, f"track/{owner}")
    if H.run(["git", "-C", wt.root, "rev-parse", "--verify", "-q", pref], check=False).returncode == 0:
        return pref
    refs = H.git(wt.root, "for-each-ref", "--format=%(refname:short)", "refs/heads").splitlines()
    for b in refs:
        if H.owner_of(b) == owner:
            return b
    raise H.HarnessError(f"no branch of owner {owner}")


def stage_dir(wt, owner, gate):
    return os.path.join(wt.root, "tracks", owner, "stage", gate)


def parse_args(args, flags=(), opts=()):
    pos, fl, op = [], set(), {}
    i = 0
    while i < len(args):
        a = args[i]
        if a in flags:
            fl.add(a)
            i += 1
        elif a in opts:
            op[a] = args[i + 1]
            i += 2
        elif a.startswith("--"):
            raise H.HarnessError(f"unknown option {a}")
        else:
            pos.append(a)
            i += 1
    if len(pos) != 2 or pos[1] not in H.GATES:
        raise H.HarnessError("usage: nrpic-stage <collect|verify|report> <ID> G<k>")
    return pos[0], pos[1], fl, op


def require_own(wt, owner):
    if wt.owner != owner:
        raise H.HarnessError(f"this worktree belongs to {wt.owner}; collect and report write only the own "
                             f"track's stage directory (run them in the worktree of {owner})")
    if not os.path.isdir(wt.track_dir()):
        raise H.HarnessError(f"no tracks/{owner}/ in {wt.root}")


# ------------------------------------------------------------------ collect

ITEM_RX = re.compile(r"^- \[(.)\] \*\*(C\d+)\*\* (.*)$")


def parse_checklist(path):
    items = []
    if not os.path.isfile(path):
        return items
    cur = None
    section_name = ""
    for line in open(path):
        line = line.rstrip("\n")
        m = ITEM_RX.match(line)
        if m:
            cur = {"id": m.group(2), "text": m.group(3).strip(), "status": "OPEN", "evidence": "",
                   "section": section_name}
            items.append(cur)
            continue
        if line.startswith("## "):
            section_name = line[3:].strip()
            cur = None
            continue
        if cur is not None:
            m = re.match(r"^\s+- status:\s*(\S*)", line)
            if m:
                cur["status"] = (m.group(1) or "OPEN").upper()
                continue
            m = re.match(r"^\s+- evidence:\s*(.*)$", line)
            if m:
                cur["evidence"] = m.group(1).strip()
    return items


def collect(wt, args):
    owner, gate, fl, _ = parse_args(args, flags=("--force",))
    require_own(wt, owner)
    charter = read_shared(wt, "coord/CHARTER.md")
    brief = read_shared(wt, BRIEF)
    groups = []
    _, gates = section(charter, r"### 9\.2 Stage gates")
    row = table_row(gates or "", gate)
    if row and len(row) >= 4:
        groups.append((f"Evidence required at every track's {gate} ({row[1]}; charter 9.2)", split_items(row[2])))
        groups.append((f"Main products of {gate} (charter 9.2)", split_items(row[3])))
    head, sheet = section(charter, SHEET[owner]) if owner in SHEET else (None, None)
    crit = track_criteria(sheet or "", gate)
    if owner == "kb":
        h2, kbsec = section(brief, r"### 12\.10\b")
        if kbsec:
            lines = [l.strip() for l in kbsec.splitlines()]
            cand = [re.sub(r"^(- |\d+\. )", "", l) for l in lines if re.match(r"^(- |\d+\. )", l)]
            cand += [" | ".join(c.strip() for c in l.strip("|").split("|"))
                     for l in lines if l.startswith("|") and not re.match(r"^\|[\s:|-]+\|$", l)][1:]
            sel = [c for c in cand if re.search(rf"\b(KB-)?{gate}\b", c)]
            crit = sel or cand or [" ".join(kbsec.split())]
            head = f"{h2} (brief)"
    groups.append((f"Track-specific criteria of {owner} for {gate} ({head or 'no sheet found'})",
                   crit or [f"(no track-specific criterion for {gate} in the sheet: write the ones agreed "
                            "with the orchestrator here, or mark NA)"]))
    _, figs = section(brief, r"### 13\.4 ")
    frow = table_row(figs or "", gate)
    if frow and len(frow) >= 3:
        groups.append((f"Minimum figures at {gate} (brief 13.4)",
                       [f"Schematic: {x}" for x in split_items(frow[1])] +
                       [f"Data figure: {x}" for x in split_items(frow[2])]))
    groups.append(("Package (brief 13.3; judged by the session)", [
        "Data figures drawn with /zoom-figure-style from registered run outputs, one script per figure, "
        "every PNG looked at",
        "Schematics drawn with /sleep-paper-figure-style: track architecture (exists / to be ported / new) "
        "and the gate timeline",
        "Working note written with /paper-writing; its manuscript checker passed with --compile",
        "Verifier subagent (fresh context) wrote VERIFIER_REPORT.md; every number of the Supplemental "
        "Material recomputed from the manifests",
        "Null results and failed runs are on record (manifests and JOURNAL)",
        "STATUS.md, JOURNAL.md and HANDOFF.md are current"]))

    path = os.path.join(stage_dir(wt, owner, gate), "CHECKLIST.md")
    old = {it["text"]: it for it in parse_checklist(path)}
    if old and "--force" not in fl:
        print(f"{os.path.relpath(path, wt.root)} exists: regenerating and keeping the status and evidence "
              "of unchanged items")
    sha = H.git(wt.root, "log", "-1", "--format=%h", "--", "coord/CHARTER.md", check=False) or "?"
    out = [f"# Checklist: {owner} {gate}", "",
           f"Collected by `harness/bin/nrpic-stage collect {owner} {gate}` on {H.utcnow()} from "
           f"`coord/CHARTER.md` (last changed in {sha}) and the brief (sections 13.3 and 13.4).",
           "For each item set `status:` to PASS, FAIL or NA (OPEN until judged) and give the evidence: run ids,",
           "figure files, KB locators, commits. `nrpic-stage report` reads this file; the automated checks are",
           "in VERIFY_RESULTS.md (`nrpic-stage verify`), not here.", ""]
    n = 0
    kept = 0
    for title, items in groups:
        out += [f"## {title}", ""]
        for t in items:
            n += 1
            prev = old.get(t)
            st, ev = (prev["status"], prev["evidence"]) if prev and "--force" not in fl else ("OPEN", "")
            kept += bool(prev and "--force" not in fl)
            box = "x" if st in ("PASS", "NA") else " "
            out += [f"- [{box}] **C{n}** {t}", f"  - status: {st}", f"  - evidence: {ev}"]
        out.append("")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(out))
    print(f"wrote {os.path.relpath(path, wt.root)}: {n} items ({kept} kept from the previous version)")
    return 0


# ------------------------------------------------------------------ verify

def export_tree(wt, rev, dest):
    os.makedirs(dest)
    p = subprocess.Popen(["git", "-C", wt.root, "archive", "--format=tar", rev, "--", ".", ":(exclude)athenak"],
                         stdout=subprocess.PIPE, env=H.boot_env())
    with tarfile.open(fileobj=p.stdout, mode="r|") as tar:
        for m in tar:
            if m.name.startswith("/") or ".." in m.name.split("/"):
                continue
            tar.extract(m, dest)
    if p.wait() != 0:
        raise H.HarnessError(f"git archive {rev} failed")


def tree_snapshot(root):
    snap = {}
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d != "__pycache__"]
        for fn in filenames:
            full = os.path.join(dirpath, fn)
            if os.path.isfile(full) and not os.path.islink(full):
                rel = os.path.relpath(full, root)
                snap[rel] = (H.sha256_file(full), os.path.getmtime(full))
    return snap


NUM = re.compile(r"[-+]?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?")


def compare_text(a, b, rtol, atol):
    ta, tb = NUM.split(a), NUM.split(b)
    na, nb = NUM.findall(a), NUM.findall(b)
    if [" ".join(x.split()) for x in ta] != [" ".join(x.split()) for x in tb] or len(na) != len(nb):
        return False, "text differs (not only numbers)"
    worst = 0.0
    for x, y in zip(na, nb):
        fx, fy = float(x), float(y)
        d = abs(fx - fy)
        if d > atol + rtol * max(abs(fx), abs(fy)):
            return False, f"number {x} -> {y} beyond rtol {rtol}, atol {atol}"
        if max(abs(fx), abs(fy)) > 0:
            worst = max(worst, d / max(abs(fx), abs(fy)))
    return True, f"numbers agree (largest relative difference {worst:.2e})"


def verify(wt, args):
    owner, gate, fl, op = parse_args(args, flags=("--no-rerun", "--no-checksums"),
                                     opts=("--timeout", "--rtol", "--atol", "--img-tol"))
    timeout = float(op.get("--timeout", 900))
    rtol, atol = float(op.get("--rtol", 1e-6)), float(op.get("--atol", 1e-12))
    img_tol = float(op.get("--img-tol", 0.005))
    own = wt.owner == owner
    rev = "HEAD" if own else owner_branch(wt, owner)
    sha = H.git(wt.root, "rev-parse", rev)
    me = wt.owner or "orch"
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    base = os.path.join(wt.home, "scratch", me, "tmp", "stage-verify", f"{owner}-{gate}-{sha[:7]}-{stamp}")
    export = os.path.join(base, "tree")
    committed = os.path.join(base, "committed")
    results = []

    def res(tag, status, msg, detail=None):
        results.append({"check": tag, "status": status, "message": msg, "detail": detail})
        print(f"[{tag:12s}] {status:4s} {msg}")

    # repository state
    if own:
        pkg = f"tracks/{owner}/stage/{gate}/"
        d = [x for x in wt.dirty() if not x[3:].startswith(pkg)]
        res("clean", "PASS" if not d else "FAIL", "worktree clean (outside the stage directory being assembled)"
            if not d else f"{len(d)} uncommitted paths: commit them first ({', '.join(x[3:] for x in d[:5])})")
    r = H.run(["git", "-C", wt.root, "merge-base", "--is-ancestor", "main", sha], check=False)
    res("sync", "PASS" if r.returncode == 0 else "FAIL",
        "main is merged into the branch" if r.returncode == 0 else "main has commits not merged: run nrpic-ctx sync")

    export_tree(wt, sha, export)
    res("export", "PASS", f"clean export of {sha[:12]} ({rev}) in {export}")
    tdir = os.path.join(export, "tracks", owner)
    if not os.path.isdir(tdir):
        res("track", "FAIL", f"no tracks/{owner}/ at {sha[:7]}")
        return finish_verify(wt, owner, gate, own, base, sha, results)
    shutil.copytree(tdir, committed)
    note = os.path.join(tdir, "note")
    scripts = os.path.join(note, "scripts")
    figs = os.path.join(note, "figures")

    # file sizes
    big = []
    for line in H.git(wt.root, "ls-tree", "-r", "-l", sha, "--", f"tracks/{owner}").splitlines():
        parts = line.split(None, 4)
        if len(parts) == 5 and parts[3].isdigit() and int(parts[3]) > 5 * 1024 * 1024:
            big.append(f"{parts[4]} ({int(parts[3]) / 2**20:.1f} MB)")
    res("size", "FAIL" if big else "PASS", "committed files above 5 MB: " + ", ".join(big) if big
        else "no committed file of the track above 5 MB")

    # the note
    mt = os.path.join(note, "main.tex")
    res("note", "PASS" if os.path.isfile(mt) else "FAIL",
        "tracks/<ID>/note/main.tex present" if os.path.isfile(mt) else "no tracks/<ID>/note/main.tex (working note)")
    if os.path.isfile(mt):
        pdf_t = H.git(wt.root, "log", "-1", "--format=%ct", sha, "--", f"tracks/{owner}/note/main.pdf", check=False)
        tex_t = H.git(wt.root, "log", "-1", "--format=%ct", sha, "--", f"tracks/{owner}/note/*.tex",
                      f"tracks/{owner}/note/sections", check=False)
        if not os.path.isfile(os.path.join(note, "main.pdf")):
            res("note-pdf", "WARN", "no compiled note/main.pdf committed (paper-writing checker with --compile)")
        elif pdf_t and tex_t and int(pdf_t) < int(tex_t):
            res("note-pdf", "WARN", "note/main.pdf is older than the last change of its .tex files")
        else:
            res("note-pdf", "PASS", "note/main.pdf committed after the last .tex change")

    # style copies
    sums = {}
    sp = os.path.join(export, "harness", "style", "SHA256SUMS")
    if os.path.isfile(sp):
        for line in open(sp):
            dgst, fn = line.split()
            sums[fn] = dgst
    copies = [fn for fn in STYLE_FILES if os.path.isfile(os.path.join(scripts, fn))]
    bad = [fn for fn in copies if sums.get(fn) != H.sha256_file(os.path.join(scripts, fn))]
    has_scripts = os.path.isdir(scripts) and any(fn.endswith(".py") for fn in os.listdir(scripts))
    if bad:
        res("style", "FAIL", "copies differ from harness/style/SHA256SUMS: " + ", ".join(bad) +
            " (copy them unchanged from harness/style/)")
    elif copies:
        res("style", "PASS", f"{len(copies)} style copies equal harness/style/SHA256SUMS ({', '.join(copies)})")
    else:
        res("style", "WARN" if has_scripts else "PASS",
            "no copy of the style libraries beside the figure scripts" if has_scripts else "no figure scripts yet")

    # figure <-> script
    figfiles = sorted(fn for fn in (os.listdir(figs) if os.path.isdir(figs) else []) if fn.endswith(FIG_EXT))
    stems = sorted({os.path.splitext(f)[0] for f in figfiles})
    orphans = [s for s in stems if not os.path.isfile(os.path.join(scripts, s + ".py"))]
    res("fig-script", "FAIL" if orphans else "PASS",
        "figures without a script of the same name: " + ", ".join(orphans) if orphans
        else f"{len(stems)} figures, each with its script")
    ns = sum(1 for s in stems if s.startswith("schem_"))
    nd = sum(1 for s in stems if not s.startswith("schem_"))
    want = MIN_FIGS[gate]
    res("min-figs", "PASS" if ns >= want[0] and nd >= want[1] else "WARN",
        f"{ns} schematics and {nd} data figures (brief 13.4 asks at least {want[0]} and {want[1]} at {gate})")

    # run manifests
    tmpl_p = os.path.join(export, "harness", "templates", "run_manifest.json")
    required = list(json.load(open(tmpl_p)).keys()) if os.path.isfile(tmpl_p) else [
        "run_id", "track", "gate", "purpose", "kind", "command", "git", "code", "env", "input", "resources",
        "outputs", "status", "exit_code", "started", "ended", "parents", "notes"]
    rdir = os.path.join(tdir, "runs")
    rids = sorted(d for d in (os.listdir(rdir) if os.path.isdir(rdir) else [])
                  if os.path.isfile(os.path.join(rdir, d, "manifest.json")))
    run_problems = {}
    for rid in rids:
        probs = []
        try:
            m = json.load(open(os.path.join(rdir, rid, "manifest.json")))
        except json.JSONDecodeError as e:
            run_problems[rid] = [f"manifest is not JSON: {e}"]
            continue
        miss = [k for k in required if k not in m]
        if miss:
            probs.append("fields missing: " + ", ".join(miss))
        if m.get("run_id") != rid:
            probs.append(f"run_id {m.get('run_id')!r} differs from the directory name")
        if m.get("kind") == "production" and m.get("gate") == gate and not m.get("preregistered_in"):
            probs.append("production run without preregistered_in")
        p2, notes, _ = H.verify_run(wt.home, wt.root, m, outputs="--no-checksums" not in fl)
        probs += p2
        if probs:
            run_problems[rid] = probs
    if not rids:
        res("runs", "PASS", "no registered runs")
    elif run_problems:
        res("runs", "FAIL", f"{len(run_problems)} of {len(rids)} runs have problems", run_problems)
    else:
        res("runs", "PASS", f"{len(rids)} run manifests complete, finished"
            + ("" if "--no-checksums" in fl else ", output checksums verified"))

    # STATUS
    stp = os.path.join(tdir, "STATUS.md")
    if os.path.isfile(stp):
        lines = open(stp).read().splitlines()
        ok = len(lines) <= 60 and any(l.startswith("gate:") for l in lines)
        res("status", "PASS" if ok else "WARN", f"STATUS.md has {len(lines)} lines" +
            ("" if ok else " (at most 60, with a `gate:` line)"))
    else:
        res("status", "FAIL", "no STATUS.md")

    # re-run figure scripts and registered commands in the clean export
    if "--no-rerun" in fl:
        res("rerun", "WARN", "re-run skipped (--no-rerun)")
        return finish_verify(wt, owner, gate, own, base, sha, results)
    before = tree_snapshot(tdir)
    t_start = time.time()
    time.sleep(1.05)                      # mtimes of regenerated files are then strictly later
    env = H.build_env(wt, extra={"NRPIC_VERIFY_ROOT": export, "NRPIC_STAGE_VERIFY": "1",
                                 "PYTHONDONTWRITEBYTECODE": "1"})
    os.makedirs(env["MPLCONFIGDIR"], exist_ok=True)
    jobs = []
    if os.path.isdir(scripts):
        for fn in sorted(os.listdir(scripts)):
            if fn.endswith(".py") and (fn.startswith("fig_") or fn.startswith("schem_")):
                jobs.append((f"note/scripts/{fn}", ["python", fn], scripts))
    vf = os.path.join(tdir, "stage", gate, "VERIFY")
    if os.path.isfile(vf):
        for line in open(vf):
            s = line.strip()
            if s and not s.startswith("#"):
                jobs.append((f"VERIFY: {s}", ["bash", "-c", s], export))
    failed = {}
    for label, argv, cwd in jobs:
        try:
            r = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True, timeout=timeout)
            rc, out = r.returncode, (r.stdout + r.stderr)[-2000:]
        except subprocess.TimeoutExpired:
            rc, out = "timeout", f"killed after {timeout} s"
        if rc != 0:
            failed[label] = {"exit": rc, "tail": out}
        elif "cut at the figure edge" in out:
            failed[label] = {"exit": 0, "tail": "czstyle: labels cut at the figure edge\n" + out}
    res("rerun", "FAIL" if failed else "PASS",
        f"{len(jobs) - len(failed)} of {len(jobs)} scripts and commands ran cleanly in the export"
        + ("" if jobs else " (none registered)"), failed or None)
    after = tree_snapshot(tdir)
    changed, compared, regenerated_figs = {}, [], set()
    for rel, (dg, mt_) in after.items():
        if rel not in before:
            changed[rel] = "new file, not in the commit"
            continue
        if mt_ <= t_start:
            continue
        if rel.startswith("note/figures/"):
            regenerated_figs.add(rel)
        if dg == before[rel][0]:
            compared.append((rel, "PASS", "identical"))
            continue
        old = os.path.join(committed, rel)
        new = os.path.join(tdir, rel)
        if rel.endswith(".png"):
            r = H.run(["python", os.path.join(LIB, "compare_images.py"), old, new], env=env, check=False)
            try:
                d = json.loads(r.stdout.strip().splitlines()[-1])
                ok = d["same_shape"] and d["rms"] <= img_tol
                compared.append((rel, "PASS" if ok else "FAIL",
                                 f"pixel rms {d['rms']}" if d["same_shape"] else f"size {d['shape_a']} -> {d['shape_b']}"))
            except (ValueError, IndexError, KeyError):
                compared.append((rel, "FAIL", "image comparison failed: " + (r.stderr or r.stdout)[-300:]))
        elif rel.endswith((".pdf", ".svg", ".eps")):
            compared.append((rel, "PASS", "regenerated (vector files carry dates; the PNG preview is compared)"))
        elif rel.endswith(TEXT_EXT):
            ok, msg = compare_text(open(old, errors="replace").read(), open(new, errors="replace").read(), rtol, atol)
            compared.append((rel, "PASS" if ok else "FAIL", msg))
        else:
            compared.append((rel, "WARN", "binary file changed (not compared)"))
    bad = [c for c in compared if c[1] == "FAIL"]
    res("compare", "FAIL" if bad else "PASS",
        f"{len(compared)} regenerated files compared with the committed ones; {len(bad)} differ beyond tolerance"
        f" (rtol {rtol}, atol {atol}, PNG rms {img_tol})", [list(c) for c in compared])
    stale = [f"note/figures/{f}" for f in figfiles if f"note/figures/{f}" not in regenerated_figs]
    res("regenerate", "FAIL" if stale else "PASS",
        "committed figures not regenerated by their scripts: " + ", ".join(stale) if stale
        else f"all {len(figfiles)} committed figure files regenerated")
    if changed:
        res("new-files", "WARN", f"{len(changed)} files written by the scripts are not in the commit",
            sorted(changed)[:50])
    return finish_verify(wt, owner, gate, own, base, sha, results)


def finish_verify(wt, owner, gate, own, base, sha, results):
    fails = [r for r in results if r["status"] == "FAIL"]
    doc = {"track": owner, "gate": gate, "commit": sha, "verified_utc": H.utcnow(), "export": base,
           "result": "FAIL" if fails else "PASS", "checks": results}
    outdir = stage_dir(wt, owner, gate) if own else base
    os.makedirs(outdir, exist_ok=True)
    H.write_json(os.path.join(outdir, "VERIFY_RESULTS.json"), doc)
    md = [f"# Re-verification: {owner} {gate}", "",
          f"`harness/bin/nrpic-stage verify {owner} {gate}` on {doc['verified_utc']}, clean export of commit "
          f"`{sha[:12]}` in `{os.path.relpath(base, wt.home)}`. Result: **{doc['result']}**.", "",
          "| Check | Result | Message |", "|---|---|---|"]
    for r in results:
        md.append(f"| {r['check']} | {r['status']} | {r['message'].replace('|', '/')} |")
    for r in results:
        if r["detail"]:
            md += ["", f"## {r['check']}", "", "```", json.dumps(r["detail"], indent=1)[:6000], "```"]
    with open(os.path.join(outdir, "VERIFY_RESULTS.md"), "w") as f:
        f.write("\n".join(md) + "\n")
    print(f"verify {owner} {gate}: {doc['result']} ({len(fails)} failed checks); "
          f"results in {os.path.relpath(outdir, wt.root) if own else outdir}/VERIFY_RESULTS.md")
    return 1 if fails else 0


# ------------------------------------------------------------------ report

FALLBACK_TEMPLATE = """# Stage report: {{ID}} {{GATE}}

Date: {{DATE}} · branch `{{BRANCH}}` at `<commit>`

## Verdict

## Criteria (coord/CHARTER.md, gate {{GATE}} of this track)

## Re-verification on a clean checkout (`nrpic-stage verify`)

## Figures

## Verifier report

## Null results and failed runs

## Open risks

## Decision requested from the group
"""


def split_sections(text):
    head, secs, cur = [], [], None
    for line in text.splitlines():
        if line.startswith("## "):
            cur = [line, []]
            secs.append(cur)
        elif cur is None:
            head.append(line)
        else:
            cur[1].append(line)
    return head, secs


def report(wt, args):
    owner, gate, fl, op = parse_args(args, opts=("--decision",))
    require_own(wt, owner)
    sd = stage_dir(wt, owner, gate)
    tp = os.path.join(wt.root, "harness", "templates", "STAGE_REPORT.md")
    template = open(tp).read() if os.path.isfile(tp) else FALLBACK_TEMPLATE
    sha = wt.head()
    date = time.strftime("%Y-%m-%d", time.gmtime())
    for k, v in (("{{ID}}", owner), ("{{GATE}}", gate), ("{{DATE}}", date), ("{{BRANCH}}", wt.branch),
                 ("<commit>", sha[:12])):
        template = template.replace(k, v)
    items = parse_checklist(os.path.join(sd, "CHECKLIST.md"))
    reasons = []
    if not items:
        reasons.append("no CHECKLIST.md (run nrpic-stage collect)")
    open_items = [i for i in items if i["status"] not in ("PASS", "NA")]
    if open_items:
        reasons.append(f"{len(open_items)} checklist items not PASS or NA: "
                       + ", ".join(f"{i['id']} {i['status']}" for i in open_items[:12]))
    vr_p = os.path.join(sd, "VERIFY_RESULTS.json")
    vr = H.read_json(vr_p) if os.path.isfile(vr_p) else None
    if vr is None:
        reasons.append("no VERIFY_RESULTS.json (run nrpic-stage verify)")
    else:
        changed = H.git(wt.root, "diff", "--name-only", vr["commit"], sha, "--", ".",
                        f":(exclude)tracks/{owner}/stage/{gate}", check=False)
        if changed:
            reasons.append(f"verify ran on {vr['commit'][:7]}; files changed since: "
                           + ", ".join(changed.splitlines()[:6]) + " (run verify again)")
        if vr["result"] != "PASS":
            reasons.append("verify reported FAIL: " + ", ".join(c["check"] for c in vr["checks"] if c["status"] == "FAIL"))
    vrep = os.path.join(sd, "VERIFIER_REPORT.md")
    if not os.path.isfile(vrep):
        reasons.append("no VERIFIER_REPORT.md (step 7: verifier subagent)")
    verdict = "FAIL" if reasons else "PASS"
    tag = f"stage/{owner}/{gate}-{verdict.lower()}-{time.strftime('%Y%m%d', time.gmtime())}"

    note = os.path.join(wt.track_dir(), "note")
    figs = os.path.join(note, "figures")
    stems = sorted({os.path.splitext(f)[0] for f in (os.listdir(figs) if os.path.isdir(figs) else [])
                    if f.endswith(FIG_EXT)})
    runs = {}
    rdir = os.path.join(wt.track_dir(), "runs")
    for d in sorted(os.listdir(rdir)) if os.path.isdir(rdir) else []:
        p = os.path.join(rdir, d, "manifest.json")
        if os.path.isfile(p):
            try:
                runs[d] = H.read_json(p)
            except json.JSONDecodeError:
                pass
    bodies = {
        "Verdict": [f"**{verdict}**. Tag: `{tag}` (created and pushed by the orchestrator after review, "
                    "decision 0003)."] + ([""] + [f"- {r}" for r in reasons] if reasons else []),
        "Criteria": ["| # | Criterion | Evidence (run id, figure, KB locator) | Result |", "|---|---|---|---|"] +
                    [f"| {i['id']} | {i['text'].replace('|', '/')} | {i['evidence'].replace('|', '/') or '—'} | "
                     f"{i['status']} |" for i in items],
        "Re-verification": ([f"`nrpic-stage verify` on {vr['verified_utc']}, clean export of `{vr['commit'][:12]}`: "
                             f"**{vr['result']}**. Details: `VERIFY_RESULTS.md`.", "",
                             "| Check | Result | Message |", "|---|---|---|"] +
                            [f"| {c['check']} | {c['status']} | {c['message'].replace('|', '/')} |" for c in vr["checks"]]
                            if vr else ["Not run: `harness/bin/nrpic-stage verify " + f"{owner} {gate}`."]),
        "Figures": ["| File | Script | Kind (data / schematic) | Looked at (PNG read) |", "|---|---|---|---|"] +
                   [f"| note/figures/{s}.* | note/scripts/{s}.py"
                    f"{'' if os.path.isfile(os.path.join(note, 'scripts', s + '.py')) else ' (MISSING)'} | "
                    f"{'schematic' if s.startswith('schem_') else 'data'} | to be confirmed by the session |"
                    for s in stems],
        "Verifier report": ([f"`tracks/{owner}/stage/{gate}/VERIFIER_REPORT.md` present; its first lines:", ""] +
                            ["> " + l for l in open(vrep).read().splitlines()[:12]]
                            if os.path.isfile(vrep) else ["MISSING: the verifier subagent has not reported."]),
        "Null results and failed runs": ([f"- `{r}`: {m.get('status')} (exit {m.get('exit_code')}), {m.get('purpose', '')}"
                                          for r, m in runs.items() if m.get("status") in ("failed", "stopped")]
                                         or ["No registered run failed or was stopped. Null results are in the "
                                             "JOURNAL entries."]),
        "Open risks": (open(os.path.join(wt.track_dir(), "RISKS.md")).read().splitlines()[1:41]
                       if os.path.isfile(os.path.join(wt.track_dir(), "RISKS.md")) else ["No RISKS.md."]),
    }
    head, secs = split_sections(template)
    out = list(head)
    for title, body in secs:
        key = next((k for k in bodies if title[3:].startswith(k)), None)
        out.append(title)
        if key:
            out += [""] + bodies[key] + [""]
        elif title[3:].startswith("Decision requested"):
            dec = op.get("--decision")
            out += ([""] + [dec, ""] if dec else
                    body + ["", "TO WRITE by the track before the package is submitted "
                            "(`nrpic-stage report ... --decision \"...\"`)."])
        else:
            out += body
    path = os.path.join(sd, "STAGE_REPORT.md")
    os.makedirs(sd, exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(out).rstrip() + "\n")
    print(f"wrote {os.path.relpath(path, wt.root)}: verdict {verdict}; proposed tag {tag}")
    for r in reasons:
        print("  - " + r)
    print(f"commit the package path-limited: git add tracks/{owner}/stage/{gate} && "
          f"git commit -m \"{H.owner_short(owner)}(note): stage {gate} package\" -- tracks/{owner}")
    return 0


def main(argv):
    try:
        c_opt, rest = H.strip_options_prefix(argv)
        if not rest or rest[0] in ("-h", "--help", "help"):
            print(__doc__)
            return 2
        sub, args = rest[0], rest[1:]
        wt = H.worktree_from_args(__file__, c_opt)
        fn = {"collect": collect, "verify": verify, "report": report}.get(sub)
        if fn is None:
            print(__doc__)
            return 2
        return fn(wt, args) or 0
    except H.HarnessError as e:
        print(f"nrpic-stage: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
