#!/usr/bin/env python3
"""Fetch arXiv e-prints into the shared raw store, one request at a time for the whole machine.

    harness/bin/nrpic-fetch-arxiv <arxiv id> [<arxiv id> ...]      (works from any worktree)

Rules of the brief (sections 0 and 17) that this command enforces:
- every session downloads through this command only: a lock file serialises all requests
  and keeps at least three seconds between them; failures back off exponentially;
- layout: kb-data/raw/arxiv/<id, slash replaced by underscore>/<version>/source.bin, extracted
  into src/ beside it; record in kb-data/meta/arxiv/<id>.json;
- the download is untrusted data: nothing in it is executed; archive members that are links,
  devices, absolute or leave the directory are skipped and listed in the record;
- requests carry a generic client name and nothing about the user or the project.
An identifier that is already complete in the store is not fetched again; its path is printed.
"""
import fcntl
import gzip
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.request

AGENT = "arxiv-source-mirror/0.1 (literature reading tool)"
GAP = 3.0


def main_checkout():
    here = os.path.dirname(os.path.abspath(__file__))
    common = subprocess.run(["git", "-C", here, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            check=True, capture_output=True, text=True).stdout.strip()
    return os.path.dirname(common)


def safe_members(tar):
    kept, skipped = [], []
    for m in tar.getmembers():
        name = m.name
        bad = (not (m.isfile() or m.isdir()) or name.startswith("/") or ".." in name.split("/")
               or len(name) > 400)
        (skipped if bad else kept).append(m)
    for m in kept:
        m.mode = 0o755 if m.isdir() else 0o644
        m.uid = m.gid = 0
        m.uname = m.gname = ""
    return kept, [m.name for m in skipped]


def unpack(blob, dest):
    """Extract into dest (new, empty). Returns (kind, skipped member names)."""
    os.makedirs(dest)
    if blob[:4] == b"%PDF":
        open(os.path.join(dest, "paper.pdf"), "wb").write(blob)
        return "pdf", []
    data = blob
    if blob[:2] == b"\x1f\x8b":
        data = gzip.decompress(blob)
    try:
        with tarfile.open(fileobj=io.BytesIO(data)) as tar:
            kept, skipped = safe_members(tar)
            tar.extractall(dest, members=kept)
        return "tar", skipped
    except tarfile.ReadError:
        open(os.path.join(dest, "main.tex"), "wb").write(data)
        return "single-file", []


def fetch(url):
    wait = 6.0
    for attempt in range(5):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": AGENT})
            with urllib.request.urlopen(req, timeout=180) as r:
                return r.read(), dict(r.headers), r.status
        except (urllib.error.URLError, TimeoutError, ConnectionError) as e:
            code = getattr(e, "code", None)
            if code in (400, 403, 404):
                raise
            if attempt == 4:
                raise
            time.sleep(wait)
            wait *= 2.0
    raise RuntimeError("unreachable")


def one(root, aid):
    key = aid.replace("/", "_")
    base = os.path.join(root, "kb-data", "raw", "arxiv", key)
    meta_path = os.path.join(root, "kb-data", "meta", "arxiv", key + ".json")
    if os.path.exists(meta_path):
        meta = json.load(open(meta_path))
        if meta.get("status") == "ok" and os.path.isdir(meta["src"]):
            print(meta["src"])
            return 0
    os.makedirs(os.path.dirname(meta_path), exist_ok=True)
    os.makedirs(os.path.join(root, "locks"), exist_ok=True)
    with open(os.path.join(root, "locks", "arxiv.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if os.path.exists(meta_path):                      # another session got it meanwhile
                meta = json.load(open(meta_path))
                if meta.get("status") == "ok" and os.path.isdir(meta["src"]):
                    print(meta["src"])
                    return 0
            url = "https://arxiv.org/e-print/" + aid
            try:
                blob, headers, status = fetch(url)
            except Exception as e:                              # recorded, not fatal for the caller's list
                json.dump({"id": aid, "status": "failed", "url": url, "error": repr(e)[:300],
                           "tried_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())},
                          open(meta_path, "w"), indent=1)
                print(f"FAILED {aid}: {e!r}", file=sys.stderr)
                return 1
            finally:
                time.sleep(GAP)
            disp = headers.get("Content-Disposition", "") or headers.get("content-disposition", "")
            m = re.search(r"v(\d+)", disp)
            version = "v" + m.group(1) if m else "vX"
            vdir = os.path.join(base, version)
            n = 0
            while os.path.exists(vdir):                         # never write into an existing directory
                n += 1
                vdir = os.path.join(base, f"{version}.retry{n}")
            os.makedirs(vdir)
            open(os.path.join(vdir, "source.bin"), "wb").write(blob)
            kind, skipped = unpack(blob, os.path.join(vdir, "src"))
            json.dump({"id": aid, "status": "ok", "url": url, "version": version, "kind": kind,
                       "bytes": len(blob), "sha256": hashlib.sha256(blob).hexdigest(),
                       "content_disposition": disp, "skipped_members": skipped,
                       "source": os.path.join(vdir, "source.bin"), "src": os.path.join(vdir, "src"),
                       "fetched_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())},
                      open(meta_path, "w"), indent=1)
            print(os.path.join(vdir, "src"))
            return 0
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 2
    root = main_checkout()
    return max(one(root, a.strip().replace("arXiv:", "")) for a in sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
