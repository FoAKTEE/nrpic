# A moving Gaussian matter clump with the extrinsic curvature that solves the momentum
# constraint (smeared Bowen-York curvature, athenak/src/pgen/nrpic/nrpic_clump_curvature.hpp;
# options and tests: tracks/core/interfaces/moving_clumps.md).  Conformal mass 0.2,
# width 1, momentum 0.06 along x (P/m = 0.3), evolved for 2 M on 64^3 cells of
# [-8, 8]^3.  Particles (written with the <problem> block they need into the JSON):
#   problems/ic/make_ic.py clumps --gaussian 0.2,1,0,0,0,0.06,0,0 --N 100000 --seed 1 \
#       --out <rundir> --prefix particles
# <problem> comp0_p1..3 must be the momentum sum m u_i of the particles (JSON, athenak.
# problem); with comp0_p1 = 0 the data are those of K_ij = 0.  This configuration with
# weighted lattice particles (--sampler lattice --lattice-h 0.25) is test T6 of
# tracks/core/JOURNAL-clump.md (run core-20261115-154935-e1a4d0c).

<comment>
problem   = moving Gaussian clump with the smeared Bowen-York curvature

<job>
basename  = clump

<mesh>
nghost    = 4
nx1       = 64
x1min     = -8.0
x1max     = 8.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -8.0
x2max     = 8.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -8.0
x3max     = 8.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 2.0
ndiag      = 1

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-10
max_iterations = 50
deposit        = true
deposit_shape  = cic
nfilter        = 4
filter_compensate = true
filter_comp_c  = -1.0
alpha_exc      = 0.0
hist_dcycle    = 1
particle_file  = particles.nrp

<problem>
pgen_name   = nrpic_cf
ncomp       = 1
comp0_type  = gaussian
comp0_mass  = 0.2
comp0_sigma = 1.0
comp0_x1    = 0.0
comp0_x2    = 0.0
comp0_x3    = 0.0
comp0_p1    = 0.06
comp0_p2    = 0.0
comp0_p3    = 0.0
comp0_s1    = 0.0
comp0_s2    = 0.0
comp0_s3    = 0.0
lapse       = isotropic

<output1>
file_type = hst
dt        = 0.125

<output2>
file_type = bin
variable  = con
dt        = 1.0
