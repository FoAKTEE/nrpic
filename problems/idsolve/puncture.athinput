# Initial-data solver of the code with punctures (tracks/core/interfaces/id_solver2.md,
# section 4): one Bowen-York puncture of bare mass m = 1 at the origin (a vertex of the
# mesh) with momentum P = (0.5, 0, 0), vacuum (no particles: no particle_file).  The
# problem generator nrpic_cf sets the Brill-Lindquist conformal factor psi_s = 1 + m/2r
# and the Bowen-York curvature; the solver keeps psi_s in closed form and solves for the
# regular part u = psi - psi_s (Brandt and Bruegmann) on the mesh of the run.
# Reference: python/nrpic/bowen_york.py, solve_axisym(1.0, P=0.5) (multipoles).
# Within id_puncture_radius bare masses of a puncture the residual is the seven-point
# form whatever id_residual; with id_residual = code the monitor of the code is used
# outside.  Matter is added with particle_file (problems/idsolve/make_ic.py shell).
# The test changes on the command line: mesh/nx1..3 (dx = 32/nx), particles/id_residual,
# particles/id_puncture_radius, problem/comp0_p1.
<comment>
problem   = initial-data solve for a boosted Bowen-York puncture

<job>
basename  = punc

<mesh>
nghost    = 4
nx1       = 64
x1min     = -16.0
x1max     = 16.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -16.0
x2max     = 16.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -16.0
x3max     = 16.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 0
tlim       = 1.0
ndiag      = 1

<z4c>
lapse_oplog     = 2.0
shift_Gamma     = 0.75
shift_eta       = 2.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
excise_chi      = 0.0

<gravity>
four_pi_G      = 1.0      # required by the module; the solver sets its own factor
threshold      = 0.0      # required: the solver sets the defect at which V cycles end
mg_bc          = robin    # psi - 1 falls off as 1/r about (robin_x1, robin_x2, robin_x3)
robin_x1       = 0.0
robin_x2       = 0.0
robin_x3       = 0.0
show_defect    = 0

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
interp         = hermite
tolerance      = 1.0e-10
max_iterations = 50
deposit        = true
deposit_shape  = cic
deposit_comp_c = 0.0
nfilter        = 0
filter_compensate = false
hist_dcycle    = 1
cstat_dcycle   = 1
field_constraints = true
field_time1    = 1.0e30   # the field dump at the start is written whenever a time is set
id_solve       = true     # solve the Hamiltonian constraint for psi at the start
id_residual    = stencil  # stencil: seven-point (recommended with punctures); code: monitor
id_psi_init    = trial    # start value: trial (problem generator) or one
id_puncture_radius = 1.0 # stencil residual within this many bare masses
id_far         = multipole # far field of the right side at the faces (default)
id_tol         = 1.0e-10  # largest residual over the largest term of the equation
id_maxit       = 60
id_lin_tol     = 1.0e-3   # conjugate gradients: residual over right side
id_lin_maxit   = 50
id_mg_tol      = 1.0e-3   # defect over source at which a preconditioner solve ends
id_dump        = true     # write <basename>.idsolve.bin (psi, K, Abar^2, E, H, ...)

<problem>
pgen_name   = nrpic_cf
ncomp       = 1
comp0_type  = puncture
comp0_mass  = 1.0
comp0_x1    = 0.0
comp0_x2    = 0.0
comp0_x3    = 0.0
comp0_p1    = 0.5
comp0_p2    = 0.0
comp0_p3    = 0.0
lapse       = one

<output1>
file_type = hst
dt        = 1.0
