# Several MPI ranks on the cards (tracks/core/interfaces/mpi.md, section 7; request of
# Track F 20261115T1507Z__to-core__two-card-or-larger-blocks.md): the mesh of Track F's
# Hills passage at mass ratio ten with finest cells m/16 (run
# F-hills-20261115-131348-634fb86, case D205_m16_r1.8_t+0090.5: 4502 MeshBlocks of 16^3
# over 12 levels, more than one card holds), here static, with three vacuum punctures at
# the centres of its refined regions (masses 0.05, 0.05, 0.5: m = 0.05, cells m/16 =
# 1/320 at level 11).  Ten cycles, for the rate and the memory on two cards:
#   mpirun -np 2 gpu_bind.sh athena -i mpi_two_card_triple.athinput
# The m/8 mesh of the same case (2332 MeshBlocks, fits one card) on the command line:
#   mesh_refinement/num_levels=11 refined_region_punc0/level=10
#   refined_region_punc1/level=10 refined_region_punc2/level=6

<job>
basename = tc
<mesh>
nghost = 4
nx1 = 64
x1min = -204.8
x1max = 204.8
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -204.8
x2max = 204.8
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -204.8
x3max = 204.8
ix3_bc = outflow
ox3_bc = outflow
<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16
<mesh_refinement>
refinement = static
num_levels = 12
max_nmb_per_rank = 4600
<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.25
nlim = 10
tlim = 100.0
ndiag = 1
