# Unit test of the reproducible random numbers (athenak/src/utils/rng.hpp, docs/RNG.md):
# the problem generator rng_test evaluates the draws inside kernels of the default
# execution space, so the same input tests the processor build and the card build.
#   key_file / table_file   draws for the keys of a file (tracks/core/analysis/rng/make_keys.py),
#                           compared with the Python twin by tracks/core/analysis/rng/compare_table.py
#   nstat                   statistical sums and histograms -> rngtest.rng_stat.txt
#   ntime                   cost per call                   -> rngtest.rng_time.txt
# Example (paths relative to the run directory):
#   athena -i rng_test.athinput problem/key_file=keys.bin problem/nstat=1e8 problem/ntime=1e7
# The mesh is a dummy and no cycle is taken.

<comment>
problem   = unit test of the reproducible random numbers

<job>
basename  = rngtest
rng_seed  = 20261115

<mesh>
nghost    = 2
nx1       = 8
x1min     = -1.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 8
x2min     = -1.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 8
x3min     = -1.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 1.0
nlim       = 0
tlim       = 1.0

# AthenaK wants one physics module: an empty set of test particles
<particles>
particle_type = nrpic
pusher        = midpoint
metric        = kerr_schild
hist_dcycle   = 0

<problem>
pgen_name  = rng_test
key_file   =                 # empty: no table
table_file = rng_table.bin
nstat      = 0
ntime      = 0
nrepeat    = 3
