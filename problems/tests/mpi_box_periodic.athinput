# Several MPI ranks, tests T1p and T2p (tracks/core/interfaces/mpi.md): particles that
# stream through a periodic box with a homogeneous metric, crossing MeshBlock, rank and
# periodic boundaries.  With particles/deposit=true the clouds wrap and cross ranks and
# the mesh integrals of E and S_i must equal the particle sums to rounding.
#   mpirun -np N athena -i mpi_box_periodic.athinput
# The particle file is made by tracks/core/analysis/mpi/mpi_tests.py.

<comment>
problem   = NRPIC on several ranks, periodic box with a homogeneous metric

<job>
basename  = box

<mesh>
nghost    = 2
nx1       = 32
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 32
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 1.0
nlim       = -1
tlim       = 3.0
ndiag      = 100

<adm>
dynamic = false

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-12
max_iterations = 100
dt             = 0.01
deposit        = false
deposit_shape  = cic
deposit_comp_c = 0.0
nfilter        = 1
filter_compensate = false
interp         = hermite
hist_dcycle    = 1
traj_dcycle    = 4
traj_ntrack    = 64
snap_dt        = 1.0
probe_x1       = 0.5
probe_x2       = 0.5
probe_x3       = 0.5
particle_file  = box.nrp

<output1>
file_type = rst
dt        = 3.0

<output2>
file_type = bin
variable  = tmunu
dt        = 1.5

<problem>
pgen_name   = nrpic_geodesic
metric_kind = homogeneous
alpha0      = 0.9
gxx         = 1.2
gxy         = 0.1
gxz         = 0.05
gyy         = 0.9
gyz         = -0.08
gzz         = 1.1
