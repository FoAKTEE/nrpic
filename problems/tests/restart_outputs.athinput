# Outputs that survive a restart (core/restart-finder, tracks/core/interfaces/
# restart_outputs.md): the deck of problems/tests/term_signal_particles.athinput (a
# matter-dominated universe on 16^3 cells in eight MeshBlocks, 4096 particles with white
# noise, periodic) in coordinates that move with +0.5 along x (problem/shift_x1), with a
# compact-object tracker that crosses the face x = 4 at t = 2:
#   python3 cosmo/ic/make_lattice.py --n 16 --ppc 1 --L 4 --noise-x 0.05 --noise-u 0.05 --seed 7 --out DIR
# Mesh history, particle history, constraint statistics and the conservation record
# (every four cycles), tracked trajectories, a snapshot, a table along a line, the
# tracker file <basename>.co_0.txt, restart files every 0.6.  The test
# (tracks/core/analysis/restart_finder/restart_test.py) runs it once without interruption
# and several times cut at a cycle (time/nlim=K) and continued from the restart file, and
# compares every output byte for byte.
<comment>
problem   = outputs of a continued run: periodic box, particles, Z4c, tracker

<job>
basename  = rso

<mesh>
nghost    = 4
nx1       = 16
x1min     = 0.0
x1max     = 4.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 16
x2min     = 0.0
x2max     = 4.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 16
x3min     = 0.0
x3max     = 4.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 3.0
ndiag      = 1

<z4c>
lapse_oplog     = 0.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.3333333333333333   # d_t alpha = -(1/3) alpha^2 K
lapse_volume    = 0.0
lapse_kdriver   = 0.0
lapse_advect    = 0.0
shift_Gamma     = 0.0                  # zero shift
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.5
damp_kappa1     = 0.02
damp_kappa1_over_alpha = false
damp_kappa2     = 0.0
excise_chi      = 0.0
co_0_type       = BH                   # tracker: x = 3 + 0.5 t, mapped back at x = 4
co_0_x          = 3.0
co_0_y          = 0.1
co_0_z          = 0.1

<particles>
particle_type  = nrpic
pusher         = midpoint
interp         = hermite
metric         = mesh
tolerance      = 1.0e-12
max_iterations = 50
deposit        = true
nfilter        = 0
filter_compensate = false
deposit_shape  = cic
alpha_exc      = -1.0
ah_exc_factor  = -1.0
hist_dcycle    = 1
snap_dt        = 2.0
nprobe         = 0
cstat_dcycle   = 4
cons_dcycle    = 4
traj_dcycle    = 2
traj_ntrack    = 16
lambda         = 0.0
source_density = true
source_extrap  = true
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cosmo
id         = flrw
hubble     = 1.0
shift_x1   = -0.5                      # frozen uniform shift beta^x = -0.5

<output1>
file_type = hst
dt        = 0.05

<output2>
file_type = tab
variable  = z4c
dcycle    = 8
slice_x2  = 0.125
slice_x3  = 0.125

<output3>
file_type = rst
dt        = 0.6
