# Fluid reference for the short-mean-free-path end (answer to track C, request
# grhydro-reference; tracks/core/interfaces/collisions.md section 12): the stock
# polytropic star of AthenaK's general-relativistic hydrodynamics (dyn_grmhd, EOS
# P = kappa rho^gamma with gamma = 2, evolved with an ideal gas of the same gamma) on an
# octant, with the spacetime evolved by Z4c (the block <z4c> below; remove it for a
# fixed spacetime).  The problem generator is not built in: build with
#   PROBLEM=dyn_grmhd/dyngr_tov scripts/build_cpu.sh <dir>     (or build_gpu.sh)
# Low resolution (cells of 0.8 for a star of radius about 8): a smoke test of the
# module in this tree, not a converged star.

<comment>
problem  = Unmagnetized TOV star

<job>
basename = tov

<mesh>
nghost = 4       # Number of ghost cells
nx1    = 32      # number of cells in x1-direction
x1min  = 0.0     # minimum x1
x1max  = 25.6    # maximum x1
ix1_bc = reflect # inner boundary
ox1_bc = diode   # outer boundary

nx2    = 32      # number of cells in x2-direction
x2min  = 0.0     # minimum x2
x2max  = 25.6    # maximum x2
ix2_bc = reflect # inner boundary
ox2_bc = diode   # outer boundary

nx3    = 32      # number of cells in x3-direction
x3min  = 0.0     # minimum x3
x3max  = 25.6    # maximum x3
ix3_bc = reflect # inner boundary
ox3_bc = diode   # outer boundary

<meshblock>
nx1  = 32        # Number of cells in each MeshBlock, X1-dir
nx2  = 32        # Number of cells in each MeshBlock, X2-dir
nx3  = 32        # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk3        # time integration algorithm
cfl_number = 0.4
nlim       = -1
tlim       = 20.0
ndiag      = 1          # cycles between diagnostic output

<coord>
general_rel = true      # general relativity
m           = 1.0
a           = 0.0
excise      = false

<mhd>
eos         = ideal     # EOS type
dyn_eos     = ideal     # EOS type
dyn_error   = reset_floor # error policy
reconstruct = ppmx      # spatial reconstruction method
rsolver     = hlle      # Riemann solver to be used
dfloor      = 1.0e-10   # floor on density rho
tfloor      = 1.0e-8  
dthreshold  = 1.02      # Threshold for flooring
gamma       = 2.0       # ratio of specific heats Gamma
dyn_scratch = 1
fofc        = true
enforce_maximum = false

<adm>

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<problem>
rhoc        = 1.28e-3 # Central density
kappa       = 100.0    # P = kappa*rho^gamma
npoints     = 10000.0  # buffer points for TOV calculation
dr          = 1e-3     # radial step for TOV calculation
b_norm      = 0.0
pcut        = 1e-6
magindex    = 1
user_hist   = true
v_pert      = -0.024

<output1>
file_type   = rst
dt          = 1000.0

<output2>
file_type   = hst      # History data dump
dt          = 0.5      # time increment between outputs
data_format = %20.15e

<output3>
file_type   = bin      # Binary output
variable    = mhd_w
dt          = 1000.
slice_x3    = 0.0
