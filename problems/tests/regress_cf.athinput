# Regression input for the problem generator nrpic_cf: one component of every type
# (table, gaussian, spheroid, puncture) without particles, two cycles, all fields
# written.  Used to show that a change of the generator leaves existing set-ups
# bit-identical (tracks/core/analysis/mp/regress.sh).  The table is written by
# tracks/core/analysis/mp/make_regress_table.py into the run directory.
<job>
basename  = reg
<mesh>
nghost    = 4
nx1       = 64
x1min     = -8.0
x1max     = 8.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -8.0
x2max     = 8.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -8.0
x3max     = 8.0
ix3_bc    = outflow
ox3_bc    = outflow
<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32
<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 2
tlim       = 1.0
<z4c>
lapse_oplog     = 2.0
shift_Gamma     = 0.75
shift_eta       = 2.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
<problem>
pgen_name   = nrpic_cf
ncomp       = 4
comp0_type  = table
comp0_file  = regress.tab
comp0_x1    = -3.0
comp1_type  = gaussian
comp1_mass  = 0.12
comp1_sigma = 0.7
comp1_x2    = 3.0
comp2_type  = spheroid
comp2_mass  = 0.2
comp2_a     = 0.8
comp2_b     = 1.6
comp2_x3    = -3.5
comp3_type  = puncture
comp3_mass  = 0.5
comp3_x1    = 3.0
comp3_x2    = -0.1
lapse       = isotropic
<output1>
file_type = hst
dt        = 1.0
<output2>
file_type = bin
variable  = z4c
dcycle    = 1
<output3>
file_type = bin
variable  = adm
dcycle    = 1
<output4>
file_type = bin
variable  = con
dcycle    = 1
<output5>
file_type = rst
dcycle    = 2
