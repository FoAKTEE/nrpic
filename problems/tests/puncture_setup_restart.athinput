# Small check of puncture_setup with a restart and with the particle module: one
# Bowen-York puncture with momentum and spin on a three-level adaptive mesh, tracker,
# refined region and horizon finder from puncture_setup, two massless tracers.  Run
# eight cycles once uninterrupted and once restarted from the dump of cycle 4
# (tracks/core/analysis/mp/restart_check.sh); the trackers, the horizon summary and
# the particle history must agree.
<job>
basename  = psr
<mesh>
nghost    = 4
nx1       = 32
x1min     = -8.0
x1max     = 8.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 32
x2min     = -8.0
x2max     = 8.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 32
x3min     = -8.0
x3max     = 8.0
ix3_bc    = outflow
ox3_bc    = outflow
<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16
<mesh_refinement>
refinement          = adaptive
num_levels          = 3
max_nmb_per_rank    = 512
ncycle_check        = 2
refinement_interval = 2
<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 8
tlim       = 100.0
ndiag      = 1
<z4c>
lapse_oplog     = 2.0
shift_Gamma     = 0.75
shift_eta       = 2.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
tracker_mode    = ode
<fastflow>
find_every      = 2
<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-10
max_iterations = 100
deposit        = false
alpha_exc      = 0.05
hist_dcycle    = 1
nparticles     = 2
p0_x1 = 5.0
p0_x2 = 0.3
p0_x3 = 0.1
p0_u1 = 0.0
p0_u2 = 0.45
p0_u3 = 0.0
p0_m  = 0.0
p1_x1 = -0.2
p1_x2 = -6.0
p1_x3 = 0.4
p1_u1 = 0.3
p1_u2 = 0.0
p1_u3 = 0.1
p1_m  = 0.0
<problem>
pgen_name       = nrpic_cf
ncomp           = 1
comp0_type      = puncture
comp0_mass      = 1.0
comp0_x1        = 0.1
comp0_x2        = -0.2
comp0_x3        = 0.05
comp0_p1        = 0.3
comp0_s3        = 0.2
comp0_corr      = approx
lapse           = precollapsed
puncture_setup  = true
puncture_radius = 1.2
<output1>
file_type = hst
dcycle    = 1
<output2>
file_type = rst
dcycle    = 4
