# One Gaussian matter clump with momentum and spin on the mesh at t = 0 (no evolution):
# constraint residuals of the deposited particles with and without the smeared
# Bowen-York curvature (tests T1 to T4 of tracks/core/JOURNAL-clump.md, run by
# tracks/core/analysis/clump/run_static.py, compared with the closed forms by
# tracks/core/analysis/clump/static_check.py).  Clump of conformal mass 0.2 and width 1
# at the origin (a cell corner); particles from
#   problems/ic/make_ic.py clumps --gaussian 0.2,1,0,0,0,0.06,0,0 --sampler lattice \
#       --lattice-h 0.125                    (weighted lattice, noise-free deposit)
# Variants from the command line (every parameter a variant changes is listed, because
# the command line can only change parameters that exist):
#   mesh/nx1=128 mesh/nx2=128 mesh/nx3=128           resolution
#   problem/comp0_p1=0.06                            momentum given to the curvature
#   problem/comp0_s3=0.04                            spin given to the curvature
#   particles/nfilter=0 particles/filter_compensate=false   deposit without filter
#   time/nlim=-1 time/tlim=2                         evolution (test T6)

<comment>
problem   = moving Gaussian clump: constraint residuals of the initial data

<job>
basename  = clump

<mesh>
nghost    = 4
nx1       = 64
x1min     = -8.0
x1max     = 8.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -8.0
x2max     = 8.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -8.0
x3max     = 8.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 0
tlim       = 1.0
ndiag      = 1

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-10
max_iterations = 50
deposit        = true
deposit_shape  = cic
nfilter        = 4
filter_compensate = true
filter_comp_c  = -1.0
alpha_exc      = 0.0
hist_dcycle    = 1
particle_file  = particles.nrp

<problem>
pgen_name   = nrpic_cf
ncomp       = 1
comp0_type  = gaussian
comp0_mass  = 0.2
comp0_sigma = 1.0
comp0_x1    = 0.0
comp0_x2    = 0.0
comp0_x3    = 0.0
comp0_p1    = 0.0
comp0_p2    = 0.0
comp0_p3    = 0.0
comp0_s1    = 0.0
comp0_s2    = 0.0
comp0_s3    = 0.0
lapse       = isotropic

<output1>
file_type = hst
dt        = 0.125

<output2>
file_type = bin
variable  = con
dt        = 1.0
