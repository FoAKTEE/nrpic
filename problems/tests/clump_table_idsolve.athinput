# One equilibrium cluster with a bulk momentum, as problems/tests/clump_table_static.athinput,
# with the elliptic initial-data solve of the code on top (<particles> id_solve;
# coord/INTERFACES/id_solver.md): psi is solved on the mesh for the deposited particles
# and the curvature of the boost table, from the trial psi of the tables (with or without
# the radial second-order correction). Test TS of tracks/core/JOURNAL-clump2.md, run by
# tracks/core/analysis/clump2/run_idsolve_static.py. Uniform mesh, one rank, Robin faces
# (requirements of the solver). Tables and particles as for clump_table_static.athinput:
#   problems/ic/make_ic.py boosted --cluster 0.819,1,0,0,0,0.3,0,0 --sampler quiet \
#       --lattice-h 0.25 --prefix cluster
# Variants from the command line: mesh/nx1..3, problem/comp0_p1..3, problem/comp0_corr=table.

<comment>
problem   = moving equilibrium cluster: elliptic solve of psi on the mesh

<job>
basename  = clump

<mesh>
nghost    = 4
nx1       = 64
x1min     = -16.0
x1max     = 16.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -16.0
x2max     = 16.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -16.0
x3max     = 16.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 0
tlim       = 1.0
ndiag      = 1

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-10
max_iterations = 50
deposit        = true
deposit_shape  = cic
nfilter        = 4
filter_compensate = true
filter_comp_c  = -1.0
alpha_exc      = 0.0
hist_dcycle    = 1
particle_file  = particles.nrp
id_solve       = true     # solve the Hamiltonian constraint for psi at the start
id_residual    = code     # the constraint monitor of the code
id_psi_init    = trial    # start from the psi of the tables
id_tol         = 1.0e-10
id_maxit       = 60
id_dump        = true     # write <basename>.idsolve.bin

<gravity>
four_pi_G      = 1.0      # required by the module; the solver sets its own factor
threshold      = 0.0      # required: the solver sets the defect at which V cycles end
mg_bc          = robin    # psi - 1 falls off as 1/r about the origin
robin_x1       = 0.0
robin_x2       = 0.0
robin_x3       = 0.0
show_defect    = 0

<problem>
pgen_name   = nrpic_cf
ncomp       = 1
comp0_type  = table
comp0_file  = cluster_c0.tab
comp0_x1    = 0.0
comp0_x2    = 0.0
comp0_x3    = 0.0
comp0_boost_file = cluster_c0.bst
comp0_p1    = 0.0
comp0_p2    = 0.0
comp0_p3    = 0.0
comp0_corr  = none
comp0_corr_file = cluster_c0_corr.tab
comp0_boost_shift = false
lapse       = table
lapse_comp  = 0

<output1>
file_type = hst
dt        = 0.125

<output2>
file_type = bin
variable  = con
dt        = 1.0

<output3>
file_type = bin
variable  = adm_psi4
dt        = 1.0
