# Test T4 of work package dfix (journal of core): external gravity of the Newtonian
# mode on an isolated domain, G = 1.  Particles of rest mass 1e-10 (their own gravity
# and the force of a cloud on itself are below 1e-8 of the external force) move in
#   - the field of a fixed point mass M = 1 at the origin, potential
#     -M/(r^2 + s^2)^(1/2) (newton_pm_mass, newton_pm_soft), or
#   - the field -(2/9) x/(t0 + t)^2 of a matter-era background (newton_bg_t0).
# Particle file and overrides: tracks/core/analysis/dfix/t4_newton.py.

<comment>
problem   = point mass and background acceleration in the Newtonian mode

<job>
basename  = npm

<mesh>
nghost    = 2
nx1       = 32
x1min     = -2.0
x1max     = 2.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 32
x2min     = -2.0
x2max     = 2.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 32
x3min     = -2.0
x3max     = 2.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 1.0
nlim       = -1
tlim       = 20.0
ndiag      = 100000

<gravity>
four_pi_G      = 12.566370614359172
threshold      = 0.0
niteration     = -1
npresmooth     = 1
npostsmooth    = 1
full_multigrid = false
fmg_ncycle     = 1
show_defect    = 0
mg_nghost      = 1
mg_bc          = multipole
mporder        = 4
auto_mporigin  = true
root_on_host   = false

<particles>
particle_type  = nrpic
pusher         = newton
interp         = hermite
dt             = 0.002
newton_expansion = none
newton_hubble  = 0.0
newton_exponent = 2.0
newton_pm_mass = 1.0        # mass of the fixed point mass (0: none)
newton_pm_x1   = 0.0        # its position
newton_pm_x2   = 0.0
newton_pm_x3   = 0.0
newton_pm_soft = 0.0        # softening length s
newton_pm_soft_frame = comoving   # comoving: s fixed in the coordinates; physical: s/a
newton_bg_t0   = 0.0        # > 0: background acceleration -(2/9) x/(t0 + t)^2
deposit        = true
deposit_shape  = cic
nfilter        = 0
hist_dcycle    = 10
traj_dcycle    = 5
traj_ntrack    = 16
snap_dt        = 10.0
particle_file  = npm.nrp
acc_nsphere    = 1
acc_radius1    = 1.0
peri_count     = true
acc_dcycle     = 10
