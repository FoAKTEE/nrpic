# Test T2 of work package dfix (journal of core): a run stopped between two scheduled
# outputs and continued from the restart file it wrote must write every scheduled
# output.  Static Schwarzschild mesh metric (48^3 cells, dx = 0.5 M) with one tracer on
# the circular orbit r = 8 M; restart dumps every 50 M, a table of the lapse along the
# x axis every 25 M, 300 M.
# Uninterrupted: restart files 00000..00006 at t = 0, 50, ..., 300; tables at 0, 25, ...
# Interrupted:  athena -i restart_schedule.athinput time/nlim=1234   (stops at t = 123.4)
#               athena -r rst/rsch.00003.rst time/nlim=-1
# (or a stop at the wall clock limit with  -t 00:00:01).

<comment>
problem   = output schedule across a restart

<job>
basename  = rsch

<mesh>
nghost    = 2
nx1       = 48
x1min     = -12.0
x1max     = 12.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 48
x2min     = -12.0
x2max     = 12.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 48
x3min     = -12.0
x3max     = 12.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 24
nx2       = 24
nx3       = 24

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 1.0
nlim       = -1
tlim       = 300.0
ndiag      = 10000

<adm>
dynamic = false

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
zero_mass      = tracer
bh_mass        = 1.0
bh_spin        = 0.0
tolerance      = 2.0e-14
max_iterations = 200
dt             = 0.1
deposit        = false
hist_dcycle    = 10
traj_dcycle    = 10
traj_ntrack    = 1
nparticles     = 1
p0_x1          = 8.0
p0_x2          = 0.0
p0_x3          = 0.0
p0_u1          = 0.31622776601683794
p0_u2          = 0.4472135954999579
p0_u3          = 0.0
p0_m           = 0.0

<problem>
pgen_name = nrpic_geodesic

<output1>
file_type = rst
dt        = 50.0

<output2>
file_type = tab
variable  = adm_alpha
dt        = 25.0
slice_x2  = 0.25
slice_x3  = 0.25
