# Reference for test 1b of tracks/core/JOURNAL-mp.md: the stock generator
# z4c_boosted_puncture (Lorentz-boosted Schwarzschild slice in isotropic coordinates with
# its analytic shift) on the mesh of by_boost.athinput.  Rest mass and velocity are
# those of the Bowen-York puncture with bare mass 1 and momentum 0.3 after the full
# correction: M_ADM = 1.0547, v = P/M_ADM = 0.2844, rest mass sqrt(M_ADM^2 - P^2) = 1.0112
# (python/nrpic/bowen_york.py).  The generator is not nrpic_cf, so tracker, refined
# region and horizon finder are written out here.

<comment>
problem   = boosted puncture of the stock generator

<job>
basename  = bref

<mesh>
nghost    = 4
nx1       = 64
x1min     = -64.0
x1max     = 64.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -64.0
x2max     = 64.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -64.0
x3max     = 64.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement          = adaptive
num_levels          = 7
max_nmb_per_rank    = 1024
ncycle_check        = 4
refinement_interval = 8

<amr_criterion0>
method = user

<z4c_amr>
method = tracker

<refined_region1>
level = 6
x1min = -1.0
x1max = 1.0
x2min = -1.0
x2max = 1.0
x3min = -1.0
x3max = 1.0

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 40.0
ndiag      = 200

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
tracker_mode    = ode
co_0_type       = BH
co_0_x          = 0.0
co_0_mass       = 1.0112
co_0_radius     = 1.0
co_0_reflevel   = 6

<fastflow>
find_every        = 16
metric_drvts      = interpolant
num_horizons      = 1
npunct            = 1
ntheta            = 16
lmax              = 8
use_puncture_0    = 0
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-5
start_time_0      = 0.0
stop_time_0       = 1.0e30

<problem>
pgen_name        = z4c_boosted_puncture
punc_ADM_mass    = 1.0112
punc_velocity_x1 = 0.2844

<output1>
file_type = hst
dt        = 0.5

<output2>
file_type = bin
variable  = con_H
slice_x3  = 0.001
dt        = 10.0

<output3>
file_type = bin
variable  = z4c_alpha
slice_x3  = 0.001
dt        = 10.0
