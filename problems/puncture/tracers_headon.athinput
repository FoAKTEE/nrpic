# Test particles around a head-on binary black hole evolved with Z4c in moving-puncture
# gauge.  Initial data: two Brill-Lindquist punctures of bare mass 0.5 at x = +-5 M,
# at rest.  The spacetime is axisymmetric about the x axis and reflection symmetric
# about x = 0 at all times, through merger and ringdown, so each tracer conserves
# L_x = y u_z - z u_y, and tracers that start in the plane x = 0 with u_x = 0 stay there.

<comment>
problem   = tracers around a head-on binary black hole

<job>
basename  = bbh

<mesh>
nghost    = 4
nx1       = 64
x1min     = -128.0
x1max     = 128.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -128.0
x2max     = 128.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -128.0
x3max     = 128.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement          = adaptive
num_levels          = 7
max_nmb_per_rank    = 1024
ncycle_check        = 4
refinement_interval = 8

<amr_criterion0>
method = user

<z4c_amr>
method            = tracker
radius_0_rad      = 15.0
radius_0_reflevel = 3

<refined_region1>
level = 6
x1min = 4.5
x1max = 5.5
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5

<refined_region2>
level = 6
x1min = -5.5
x1max = -4.5
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5

<refined_region3>
level = 3
x1min = -15.0
x1max = 15.0
x2min = -15.0
x2max = 15.0
x3min = -15.0
x3max = 15.0

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 200.0
ndiag      = 200

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
nco             = 2
co_0_type       = BH
co_0_x          = 5.0
co_0_mass       = 0.5
co_0_radius     = 1.0
co_0_reflevel   = 6
co_1_type       = BH
co_1_x          = -5.0
co_1_mass       = 0.5
co_1_radius     = 1.0
co_1_reflevel   = 6
tracker_mode    = ode

<fastflow>
find_every        = 16
num_horizons      = 1
npunct            = 0
ntheta            = 16
lmax              = 8
use_puncture_0    = -1
center_x_0        = 0.0
center_y_0        = 0.0
center_z_0        = 0.0
initial_radius_0  = 1.0
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-5
start_time_0      = 40.0
stop_time_0       = 1000.0
verbose           = false

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-10
max_iterations = 100
deposit        = false
alpha_exc      = 0.05
hist_dcycle    = 10
traj_dcycle    = 4
traj_ntrack    = 6
nparticles     = 6
# particle 0: in the plane x = 0, r = 8, L_x = 3.677428, period about 170.5
p0_x1 = 0
p0_x2 = 8
p0_x3 = 0
p0_u1 = 0
p0_u2 = 0
p0_u3 = 0.4596785218238565
p0_m  = 0.0
# particle 1: in the plane x = 0, r = 10, L_x = 3.891850, period about 230.0
p1_x1 = 0
p1_x2 = 10
p1_x3 = 0
p1_u1 = 0
p1_u2 = 0
p1_u3 = 0.3891849859270371
p1_m  = 0.0
# particle 2: in the plane x = 0, r = 12, L_x = 4.113267, period about 295.2
p2_x1 = 0
p2_x2 = 12
p2_x3 = 0
p2_u1 = 0
p2_u2 = 0
p2_u3 = 0.3427722177686565
p2_m  = 0.0
# particle 3: off the symmetry plane, x = 4
p3_x1 = 4
p3_x2 = 10.50870138038167
p3_x3 = 3.250722273274735
p3_u1 = 0.05
p3_u2 = -0.1075297353818645
p3_u3 = 0.3476144018606456
p3_m  = 0.0
# particle 4: off the symmetry plane, x = -6, 0.8 L_circ
p4_x1 = -6
p4_x2 = 0
p4_x3 = 12
p4_u1 = -0.03
p4_u2 = 0.2742177742149252
p4_u3 = 0
p4_m  = 0.0
# particle 5: at rest at z = 13 on the symmetry plane
p5_x1 = 0
p5_x2 = 0
p5_x3 = 13
p5_u1 = 0
p5_u2 = 0
p5_u3 = 0
p5_m  = 0.0

<problem>
pgen_name  = nrpic_cf
ncomp      = 2
comp0_type = puncture
comp0_mass = 0.5
comp0_x1   = 5.0
comp1_type = puncture
comp1_mass = 0.5
comp1_x1   = -5.0
lapse      = precollapsed

<output1>
file_type = hst
dt        = 1.0

<output2>
file_type = rst
dt        = 50.0
