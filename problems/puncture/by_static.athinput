# Bowen-York punctures on the mesh at t = 0 (no evolution): the constraint residuals
# and the extrinsic curvature are written once and compared with their closed forms by
# tracks/core/analysis/mp/static_check.py.  One puncture of bare mass 1 at the origin
# (a cell corner) with momentum 0.3 along x; other cases from the command line:
#   mesh/nx1=128 mesh/nx2=128 mesh/nx3=128                  resolution
#   problem/comp0_p1=0.1 ...                                 momentum
#   problem/comp0_s3=0.4                                     spin
#   problem/comp0_corr=approx                                closed-form correction
#   problem/comp0_corr=table problem/comp0_corr_file=f.tab   tabulated correction
#   problem/ncomp=2 problem/comp1_type=puncture ...          second puncture

<comment>
problem   = Bowen-York initial data at t = 0

<job>
basename  = bys

<mesh>
nghost    = 4
nx1       = 64
x1min     = -4.0
x1max     = 4.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -4.0
x2max     = 4.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -4.0
x3max     = 4.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 0
tlim       = 1.0

<z4c>
lapse_oplog     = 2.0
shift_Gamma     = 0.75
shift_eta       = 2.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02

<problem>
pgen_name  = nrpic_cf
ncomp      = 1
comp0_type = puncture
comp0_mass = 1.0
comp0_p1   = 0.3
lapse      = precollapsed

<output1>
file_type = hst
dt        = 1.0

<output2>
file_type = bin
variable  = con
dt        = 1.0

<output3>
file_type = bin
variable  = adm
dt        = 1.0
