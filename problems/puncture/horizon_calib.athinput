# Horizon-mass calibration: vacuum puncture of unit mass, same mesh family and
# horizon-finder settings as the collapse runs. The apparent-horizon mass of an exact
# Schwarzschild puncture is 1; what the finder reports after the gauge transient
# measures the error of the evolution near the puncture plus the error of the finder.
# Variants (command line):
#   refined_region1/level=4 refined_region2/level=4   dx = M/4 at the puncture
#   (default)                                         dx = M/8
#   refined_region2/level=6                           dx = M/16 inside |x| < 2 M
#   fastflow/mass_tol_0=1e-8 fastflow/flow_iterations_0=4000 fastflow/find_every=160
#   fastflow/ntheta=32 fastflow/lmax=16
# Test particles around a black hole evolved with Z4c in moving-puncture gauge.
# Initial data: one Brill-Lindquist puncture (Schwarzschild in isotropic coordinates)
# with precollapsed lapse.  Six massless tracers: three circular equatorial orbits, an
# inclined circular orbit, a plunging orbit with angular momentum below the last bound
# value, and a radial infall.  Axisymmetry of the
# evolved slice keeps L_z exact in the continuum; the areal radius of the circular
# orbits is gauge invariant.

<comment>
problem   = tracers around an evolved Schwarzschild puncture

<job>
basename  = punc

<mesh>
nghost    = 4
nx1       = 64
x1min     = -128.0
x1max     = 128.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -128.0
x2max     = 128.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -128.0
x3max     = 128.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement       = static
max_nmb_per_rank = 512

<refined_region1>
level = 5
x1min = -1.5
x1max = 1.5
x2min = -1.5
x2max = 1.5
x3min = -1.5
x3max = 1.5

<refined_region2>
level = 5
x1min = -1.5
x1max = 1.5
x2min = -1.5
x2max = 1.5
x3min = -1.5
x3max = 1.5

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 60.0
ndiag      = 200

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<fastflow>
find_every        = 16
num_horizons      = 1
npunct            = 0
ntheta            = 16
lmax              = 8
use_puncture_0    = -1
center_x_0        = 0.0
center_y_0        = 0.0
center_z_0        = 0.0
initial_radius_0  = 0.8
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-5
start_time_0      = 0.0
stop_time_0       = 1000.0
verbose           = false

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-10
max_iterations = 100
deposit        = false
alpha_exc      = 0.05
hist_dcycle    = 10
traj_dcycle    = 4
traj_ntrack    = 6
nparticles     = 6
# particle 0: circular, r_iso=6, areal R=7.041667, L=3.502637690, E=0.945052969, period 117.407
p0_x1 = 6
p0_x2 = 0
p0_x3 = 0
p0_u1 = 0
p0_u2 = 0.5837729484039818
p0_u3 = 0
p0_m  = 0.0
# particle 1: circular, r_iso=8, areal R=9.031250, L=3.677428175, E=0.952697317, period 170.530
p1_x1 = 8
p1_x2 = 0
p1_x3 = 0
p1_u1 = 0
p1_u2 = 0.4596785218238565
p1_u3 = 0
p1_m  = 0.0
# particle 2: circular, r_iso=10, areal R=11.025000, L=3.891849859, E=0.959478817, period 230.011
p2_x1 = 10
p2_x2 = 0
p2_x3 = 0
p2_u1 = 0
p2_u2 = 0.3891849859270371
p2_u3 = 0
p2_m  = 0.0
# particle 3: circular, r_iso=8, inclined 40 deg
p3_x1 = 8
p3_x2 = 0
p3_x3 = 0
p3_u1 = 0
p3_u2 = 0.3521341772643112
p3_u3 = 0.2954756582673984
p3_m  = 0.0
# particle 4: plunging, from r_iso=12 with 0.8 L_circ (below the minimum for a bound orbit)
p4_x1 = 0
p4_x2 = 12
p4_x3 = 0
p4_u1 = -0.2742177742149252
p4_u2 = 0
p4_u3 = 0
p4_m  = 0.0
# particle 5: radial infall from rest at r_iso=10
p5_x1 = 0
p5_x2 = 0
p5_x3 = 10
p5_u1 = 0
p5_u2 = 0
p5_u3 = 0
p5_m  = 0.0

<problem>
pgen_name  = nrpic_cf
ncomp      = 1
comp0_type = puncture
comp0_mass = 1.0
lapse      = precollapsed

<output1>
file_type = hst
dt        = 1.0

<output2>
file_type = rst
dt        = 50.0
