# One Bowen-York puncture with linear momentum, evolved with Z4c in moving-puncture
# gauge (test 1b of tracks/core/JOURNAL-mp.md).  Bare mass 1, momentum 0.3 along x,
# closed-form correction of the conformal factor.  The tracker, the refined region
# around the puncture (finest cells 1/32 within 1 M) and the horizon finder are set by
# puncture_setup; the refinement follows the tracker.
# Variants (command line): problem/comp0_p1=0.6, problem/comp0_corr=none,
# mesh_refinement/num_levels=6 (finest cells 1/16).

<comment>
problem   = boosted Bowen-York puncture

<job>
basename  = byb

<mesh>
nghost    = 4
nx1       = 64
x1min     = -64.0
x1max     = 64.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -64.0
x2max     = 64.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -64.0
x3max     = 64.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement          = adaptive
num_levels          = 7
max_nmb_per_rank    = 1024
ncycle_check        = 4
refinement_interval = 8

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 40.0
ndiag      = 200

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
tracker_mode    = ode

<problem>
pgen_name       = nrpic_cf
ncomp           = 1
comp0_type      = puncture
comp0_mass      = 1.0
comp0_p1        = 0.3
comp0_corr      = approx
lapse           = precollapsed
puncture_setup  = true
puncture_radius = 1.0

<output1>
file_type = hst
dt        = 0.5

<output2>
file_type = bin
variable  = con_H
slice_x3  = 0.001
dt        = 10.0

<output3>
file_type = bin
variable  = z4c_alpha
slice_x3  = 0.001
dt        = 10.0
