# One Bowen-York puncture with linear momentum and spin, evolved with Z4c in
# moving-puncture gauge (test 1b of tracks/core/JOURNAL-mp.md).  Bare mass 1 at x = -4,
# momentum 0.3 along x, closed-form correction of the conformal factor.  The tracker,
# the refined region around the puncture (finest cells 1/16 within 0.9 M) and the
# horizon finder are set by puncture_setup; the refinement follows the tracker.
# puncture_radius is not a multiple of the finest MeshBlock size (1 M): with a tracker
# on a block corner and a radius of exactly one block, round-off decides which
# neighbouring blocks are refined.
# Variants (command line): problem/comp0_p1=0.6, problem/comp0_corr=none,
# problem/comp0_s3=0.3, mesh_refinement/num_levels=7 (finest cells 1/32).

<comment>
problem   = boosted Bowen-York puncture

<job>
basename  = byb

<mesh>
nghost    = 4
nx1       = 64
x1min     = -64.0
x1max     = 64.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -64.0
x2max     = 64.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -64.0
x3max     = 64.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement          = adaptive
num_levels          = 6
max_nmb_per_rank    = 2048
ncycle_check        = 4
refinement_interval = 8

<z4c_amr>
method            = tracker
radius_0_rad      = 18.0
radius_0_reflevel = 2

# cells of 1/2 within 18 of the origin, for the wave extraction at 12 and 16
<refined_region_wave>
level = 2
x1min = -18.0
x1max = 18.0
x2min = -18.0
x2max = 18.0
x3min = -18.0
x3max = 18.0

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 40.0
ndiag      = 200

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
tracker_mode    = ode
nrad_wave_extraction = 2
extraction_radius_0  = 12.0
extraction_radius_1  = 16.0
extraction_nlev      = 10
waveform_dt          = 0.25

<problem>
pgen_name       = nrpic_cf
ncomp           = 1
comp0_type      = puncture
comp0_mass      = 1.0
comp0_x1        = -4.0
comp0_p1        = 0.3
comp0_p2        = 0.0
comp0_p3        = 0.0
comp0_s1        = 0.0
comp0_s2        = 0.0
comp0_s3        = 0.0
comp0_corr      = approx
lapse           = precollapsed
puncture_setup  = true
puncture_radius = 0.9

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = bin
variable  = con_H
slice_x3  = 0.001
dt        = 10.0

<output3>
file_type = bin
variable  = z4c_alpha
slice_x3  = 0.001
dt        = 10.0
