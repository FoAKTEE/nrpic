# Monoenergetic (Shapiro-Teukolsky) relativistic cluster, compact models (paper Sec.
# III D, y_c = 0.605, 0.500, 0.283) at reduced particle number.  Domain
# [-512 M, 512 M]^3, initial nest down to dx = M/4 inside the central (16 M)^3 box,
# adaptive refinement with the Loehner indicator down to dx = M/16, lapse excision,
# apparent-horizon finder centred on the origin.

<comment>
problem   = monoenergetic relativistic cluster

<job>
basename  = st

<mesh>
nghost    = 4
nx1       = 64
x1min     = -512.0
x1max     = 512.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -512.0
x2max     = 512.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -512.0
x3max     = 512.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement          = adaptive
num_levels          = 9
max_nmb_per_rank    = 1024
ncycle_check        = 4
refinement_interval = 8

<amr_criterion0>
method = user

<z4c_amr>
method          = lohner
lohner_refine   = 0.2
lohner_derefine = 0.02
lohner_eps      = 0.01
radius_0_rad      = 6.0
radius_0_reflevel = 6

<refined_region1>
level = 6
x1min = -6.0
x1max = 6.0
x2min = -6.0
x2max = 6.0
x3min = -6.0
x3max = 6.0

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 300.0
ndiag      = 50

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<fastflow>
find_every        = 16
metric_drvts      = interpolant   # derivative of the metric interpolant; 'stored' is the original, wrong near block faces
num_horizons      = 1
npunct            = 0
ntheta            = 16
lmax              = 8
use_puncture_0    = -1
center_x_0        = 0.0
center_y_0        = 0.0
center_z_0        = 0.0
initial_radius_0  = 1.0
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-5
start_time_0      = 10.0
stop_time_0       = 10000.0
verbose           = false

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-7
max_iterations = 50
deposit        = true
nfilter        = 4
filter_compensate = false  # one extra pass cancelling the widening of the binomial passes
filter_comp_c  = -1.0          # its coefficient; negative: nfilter/4
deposit_max_level = 31
deposit_adaptive  = true   # cloud level follows the local particle density ...
deposit_min_level = 6      # ... and is never coarser than dx = M/4
deposit_ppc       = 2.0
alpha_exc      = 0.1
hist_dcycle    = 1
snap_dt        = 1.0
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cf
ncomp      = 1
comp0_type = table
comp0_file = cluster.tab
lapse      = table

<output1>
file_type = hst
dt        = 1.0

<output2>
file_type = rst
dt        = 20.0
