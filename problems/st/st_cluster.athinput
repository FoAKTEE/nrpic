# Monoenergetic (Shapiro-Teukolsky) relativistic cluster (paper Sec. III D) at reduced
# particle number.  Defaults: y_c = 0.819, static nest down to dx = M/2 inside the
# central (32 M)^3 box, domain [-1024 M, 1024 M]^3.

<comment>
problem   = monoenergetic relativistic cluster

<job>
basename  = st

<mesh>
nghost    = 4
nx1       = 128
x1min     = -1024.0
x1max     = 1024.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 128
x2min     = -1024.0
x2max     = 1024.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 128
x3min     = -1024.0
x3max     = 1024.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<mesh_refinement>
refinement       = static
max_nmb_per_rank = 512

<refined_region1>
level = 5
x1min = -12.0
x1max = 12.0
x2min = -12.0
x2max = 12.0
x3min = -12.0
x3max = 12.0

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 300.0
ndiag      = 50

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-7
max_iterations = 50
deposit        = true
nfilter        = 4
alpha_exc      = 0.1
hist_dcycle    = 1
snap_dt        = 2.0
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cf
ncomp      = 1
comp0_type = table
comp0_file = cluster.tab
lapse      = table

<output1>
file_type = hst
dt        = 1.0

<output2>
file_type = rst
dt        = 20.0
