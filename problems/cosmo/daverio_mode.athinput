# Plane-wave linear mode over a thousandfold expansion (cosmo/PLAN.md, C5; test B of
# Daverio, Dirian & Mitsou, arXiv:1904.07841): delta_N = A sin(2 pi x / L), A = 1e-7,
# L = 128 Mpc/h = 1.35085 initial Hubble radii, from z = 1000 (a = 1 here) to z = 0
# (a = 1001, t = 61.277). Initial data: cosmo/ic/make_east.py --ratios 1,0,0.

<comment>
problem   = single-wavelength inhomogeneities in an expanding universe

<job>
basename  = east

<mesh>
nghost    = 4
nx1       = 32
x1min     = 0.0
x1max     = 1.35085
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = 0.0
x2max     = 1.35085
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 32
x3min     = 0.0
x3max     = 1.35085
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 61.277
ndiag      = 1000

<z4c>
lapse_oplog     = 0.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.3333333333333333   # d_t alpha = -(1/3) alpha^2 K
lapse_volume    = 0.0                  # 1/3 (with lapse_harmonic = 0): alpha - gamma^(1/6) constant
lapse_advect    = 0.0
shift_Gamma     = 0.0                  # zero shift
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.5
damp_kappa1     = 0.02
damp_kappa1_over_alpha = false         # true: damping rate kappa1 per unit of coordinate time
damp_kappa2     = 0.0
damp_ch         = 0.0
damp_ch_dx      = 0.0
excise_chi      = 0.0                  # constraint norms over the whole box (chi = 1/a^2 falls)

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
tolerance      = 1.0e-12
max_iterations = 50
deposit        = true
nfilter        = 0
filter_compensate = false
filter_comp_c  = -1.0
deposit_shape  = tsc     # cloud shape: cic, tsc or pcs (B-spline of degree 1, 2, 3)
deposit_max_level = 31
deposit_adaptive  = false
deposit_min_level = 0
deposit_ppc       = 2.0
deposit_max_coarsen = 31
alpha_exc      = -1.0
ah_exc_factor  = -1.0
hist_dcycle    = 16
cstat_dcycle   = 16       # constraint statistics (maximum and mean, absolute and relative)
line_dcycle    = 64       # records of chi, alpha, K, E, S_x along the first x1 line
traj_dcycle    = 0        # trajectories of the fiducial observers (lowest tags)
traj_ntrack    = 94       # 3 n - 2 for one particle per cell and direction
snap_dt        = 100.0
probe_x1       = 0.3377125
probe_x2       = 0.3377125
probe_x3       = 0.3377125
nprobe         = 1
probe1_x1      = 1.0131375
probe1_x2      = 0.3377125
probe1_x3      = 0.3377125
lambda         = 0.0
source_density = true    # densities converted with the volume element of each stage
source_extrap  = true    # ... extrapolated to the middle of the step
particle_file  = particles.nrp

<problem>
pgen_name  = nrpic_cosmo
id         = file
id_file    = fields.bin
hubble     = 1.0

<output1>
file_type = hst
dt        = 0.5
