# Homogeneous scalar field with the evolved metric in a periodic box: slow roll in a
# quadratic potential (tracks/core/JOURNAL-scalar.md, test 2).  Units G = c = 1.
# Lapse condition d_t alpha = -(1/3) alpha^2 K (cosmo/README.md): alpha = a, the time
# coordinate is conformal time.  For geodesic slicing (alpha = 1, cosmic time) set
# z4c/lapse_harmonic=0.  Reference: python/nrpic/scalar_field.py, friedmann().

<comment>
problem   = homogeneous slow roll, quadratic potential

<job>
basename  = sr

<mesh>
nghost    = 4
nx1       = 16
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 16
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 16
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 1.2
ndiag      = 100

<z4c>
lapse_oplog     = 0.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.3333333333333333   # d_t alpha = -(1/3) alpha^2 K
lapse_advect    = 0.0
shift_Gamma     = 0.0                  # zero shift
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.0
damp_kappa1     = 0.0
damp_kappa2     = 0.0
excise_chi      = 0.0

<scalar_field>
couple      = true
potential   = quadratic
mass        = 0.1
hist_dcycle = 1
dump_dcycle = 0
dump_dt     = -1.0

<problem>
pgen_name  = scalar_field
id         = flrw
phi0       = 3.0
pi0        = -0.016286750396764   # slow-roll attractor -m^2 phi/(3 H), H^2 = (4 pi/3) m^2 phi^2
