# Stochastic inflation, slow-roll (quadratic) case of arXiv:2512.14649 as in
# sr_stochastic.athinput (32^3, k_max/dk = 8, initial slice at N*, Mukhanov-Sasaki
# sources), with a lapse that is not geodesic: the stochastic sources carry the box mean
# of the lapse and their background runs in its proper time, so any lapse condition
# with a homogeneous background part can be used (tracks/core/JOURNAL-scalar3.md, tests
# G1 and G2; interface tracks/core/interfaces/scalar_field_3.md, section on the gauge).
#   lapse_harmonic = c   d_t alpha = -c alpha^2 Khat: alpha = 1/(1 - 3 c int H dt) on the
#                        background (c = 1/3: conformal time; unusable for many e-folds
#                        at a fixed step, the step in e-folds grows with alpha)
#   lapse_kdriver = mu   d_t alpha = -mu alpha_ref alpha (Khat - <Khat>): the mean lapse
#                        stays 1, the lapse falls where the expansion lags
# As it stands: lapse_harmonic = 0.05 (test G1), 3.3 e-folds end at t = 2.6.

<comment>
problem   = stochastic inflation, slow-roll case, lapse that is not geodesic

<job>
basename  = srg
rng_seed  = 20261115

<mesh>
nghost    = 4
nx1       = 32
x1min     = 0.0
x1max     = 6.283185307179586
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = 0.0
x2max     = 6.283185307179586
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 32
x3min     = 0.0
x3max     = 6.283185307179586
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 2.6
ndiag      = 20

<z4c>
lapse_oplog     = 0.0
lapse_harmonic  = 0.05    # d_t alpha = -0.05 alpha^2 Khat
lapse_volume    = 0.0
lapse_kdriver   = 0.0     # driver towards constant mean curvature
lapse_advect    = 0.0
shift_Gamma     = 0.0     # zero shift
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.0
damp_kappa1     = 0.0
damp_kappa2     = 0.0
excise_chi      = 0.0

<scalar_field>
couple           = true
potential        = quadratic
mass             = 1.82877655899024605e-01
diss             = 0.0
hist_dcycle      = 1
con_dcycle       = 1          # record of |H|/[H], |M|/[M]: <basename>.sf.con.hst
con_signed       = true       # record, columns 21-27: <H>, <M_i>, and of H' = H - <H>:
                              # <|H'|/[H]>, max |H'|/[H], rms H' (branch core/scalar-3)
dump_dt          = 0.4
dump_metric      = true       # dumps with gt_ij and At_ij (layout NRSFDMP2)
dump_magnitudes  = false      # dumps with [H], [M] and the M_i of the BSSN form
dump_constraints = true       # dumps with H, M_i, E
dump_noise       = false      # dumps without the six stochastic fields
noise            = mukhanov_sasaki
noise_nmax2      = 64
noise_sharpness  = 5.0
noise_sigma      = 1.0        # k_sigma = sigma a H
noise_level      = 0          # background: 0 Friedmann equations, 1 box means
noise_projector  = stencil
noise_kick_pi    = true
noise_kick_k     = true
noise_kick_a     = true
noise_pi_sign    = 1.0        # -1: negative control of the sources
noise_mode_file  = sr_stochastic_modes.txt
noise_mode_scale = 1.0        # factor on the mode functions (slice and sources)

<problem>
pgen_name      = scalar_field
id             = stochastic
phi0           = -2.66679478988261254e+00   # background at N*
pi0            = 2.97300406808996935e-02
slice_window   = true         # false: R and dR/dtau of the mode file without the window
slice_k2       = stencil      # k^2 of the Bardeen potential: stencil or continuum
slice_delta_pi = corrected    # printed: negative control of the slice
