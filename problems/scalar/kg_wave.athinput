# Klein-Gordon plane wave of a test field on flat spacetime in a periodic box
# (tracks/core/JOURNAL-scalar.md, test 1).  The spacetime is evolved by Z4c and stays
# flat because the field does not source it (couple = false).
#   phi = amp cos(k.x - omega t),  k = 2 pi (n1, n2, n3)/L,  omega^2 = k^2 + mass^2

<comment>
problem   = Klein-Gordon plane wave, test field

<job>
basename  = kg

<mesh>
nghost    = 4
nx1       = 16
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 16
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 16
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 2.0
ndiag      = 100

<z4c>
lapse_oplog     = 0.0     # geodesic slicing: alpha = 1
lapse_harmonic  = 0.0
lapse_advect    = 0.0
shift_Gamma     = 0.0     # zero shift
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.0
damp_kappa1     = 0.0
damp_kappa2     = 0.0

<scalar_field>
couple      = false       # test field
potential   = quadratic
mass        = 5.0
diss        = 0.0
hist_dcycle = 1
dump_dcycle = 0
dump_dt     = 0.25

<problem>
pgen_name  = scalar_field
id         = wave
phi0       = 0.0
pi0        = 0.0
amp        = 1.0
n1         = 1
n2         = 1
n3         = 0
