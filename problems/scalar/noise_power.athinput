# Stochastic sources of the scalar field, generic model (prescribed amplitude and
# window), on a test field in flat spacetime (tracks/core/JOURNAL-scalar.md, test 4).
# Box [-0.5, 0.5]^3; the increment field of every step has the Fourier coefficients
#   amp q^((tilt-3)/2) L^(-3/2) g(dW_q) alpha_n,   q = |n| <= sqrt(noise_nmax2).

<comment>
problem   = stochastic sources, generic model

<job>
basename  = np
rng_seed  = 20261115

<mesh>
nghost    = 4
nx1       = 32
x1min     = -0.5
x1max     = 0.5
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 32
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 64
tlim       = 100.0
ndiag      = 16

<z4c>
lapse_oplog     = 0.0
lapse_harmonic  = 0.0
lapse_advect    = 0.0
shift_Gamma     = 0.0
shift_eta       = 0.0
shift_advect    = 0.0
diss            = 0.0
damp_kappa1     = 0.0
damp_kappa2     = 0.0

<scalar_field>
couple          = false
potential       = quadratic
mass            = 0.0
diss            = 0.0
hist_dcycle     = 16
dump_dcycle     = 32
noise           = power
noise_scheme    = frozen     # frozen, or markov (new amplitudes every step)
noise_window    = tanh       # tanh or heaviside
noise_sharpness = 5.0
noise_nmax2     = 100
noise_amp       = 1.0
noise_tilt      = 0.0
noise_ksigma0   = 3.0        # k_sigma/k_f = ksigma0 exp(hubble (t - t0))
noise_hubble    = 2.0
noise_t0        = 0.0
noise_c_phi     = 1.0        # d_t phi += c_phi xi_0/dt
noise_c_pi      = 0.5        # d_t Pi  += c_pi xi_1/dt
noise_pi_dof    = 1          # xi_1 has its own amplitudes (0: those of xi_0)

<problem>
pgen_name  = scalar_field
id         = wave
phi0       = 0.0
pi0        = 0.0
amp        = 0.0

<output1>
file_type  = rst
dcycle     = 32
