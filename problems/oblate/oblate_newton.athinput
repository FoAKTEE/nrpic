# Newtonian reference of the oblate collapse (test T4 of tracks/core/JOURNAL-oblate.md):
# the particles of the relativistic run (problems/ic/make_ic.py oblate --e 0.9 --a 10
# --N 10000 --seed 1) move in the Newtonian potential of their own rest mass
# (<particles> pusher = newton, release core-v0.3, coord/INTERFACES/newtonian_mode.md),
# with the cloud shape and filter of the relativistic runs (CIC, four binomial passes
# with compensation).  Isolated box of half-width 16 M around the spheroid (a = 10 M,
# b = 4.36 M), potential on the faces from the multipole expansion.  Units G = 1.  The
# test sets the mesh (64^3: cells M/2; 128^3: cells M/4) and the particle file on the
# command line, for example
#   athena -i oblate_newton.athinput -d OUT particles/particle_file=PATH.nrp
#   athena -i oblate_newton.athinput -d OUT mesh/nx1=128 mesh/nx2=128 mesh/nx3=128 ...
# Reference: tracks/core/analysis/oblate/newton_spheroid.py (homogeneous spheroid; with
# the total rest mass 1.0747 of the particles the pancake is at 20.46/sqrt(1.0747) M).

<comment>
problem   = oblate collapse, Newtonian mode

<job>
basename  = obl

<mesh>
nghost    = 4
nx1       = 64
x1min     = -16.0
x1max     = 16.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -16.0
x2max     = 16.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -16.0
x3max     = 16.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic
integrator = rk2          # not used by the particles; the driver needs one
cfl_number = 1.0
nlim       = -1
tlim       = 24.0
ndiag      = 100

<gravity>
four_pi_G      = 12.566370614359172   # G = 1
threshold      = 0.0      # 0: V cycles until the defect stops falling
niteration     = -1
npresmooth     = 1
npostsmooth    = 1
full_multigrid = false    # start from the potential of the previous step
fmg_ncycle     = 1
show_defect    = 0
mg_nghost      = 1
mg_bc          = multipole   # isolated domain
mporder        = 4
auto_mporigin  = true
root_on_host   = false

<particles>
particle_type  = nrpic
pusher         = newton    # Newtonian mode: Poisson equation, kick-drift-kick
interp         = hermite
dt             = 0.02      # upper limit of the step (0.012 M of travel at the pancake)
newton_cfl     = 0.0
newton_mg_tol  = 0.0
newton_expansion = none
newton_hubble  = 0.0
newton_exponent = 2.0
deposit        = true
deposit_shape  = cic       # as in the relativistic runs
nfilter        = 4         # as in the relativistic runs
filter_compensate = true
filter_comp_c  = -1.0
deposit_comp_c = 0.0
deposit_comp_limit = 0.0
deposit_comp_c2 = 0.0
hist_dcycle    = 5
traj_dcycle    = 0
traj_ntrack    = 0
snap_dt        = 0.25
probe_x1       = 0.0
probe_x2       = 0.0
probe_x3       = 0.0
nprobe         = 0
particle_file  = particles.nrp

<problem>
pgen_name = nrpic_newton   # particles only; nothing is set on the mesh

<output1>
file_type = rst
dt        = 1.0e30
