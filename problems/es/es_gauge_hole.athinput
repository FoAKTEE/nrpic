# SECOND PASS OF THE RELAXED LAPSE (tracks/core/JOURNAL-gauge-2.md; interface
# cosmo_gauge.md section 9): problems/es/es_gauge.athinput for 100 M with the relaxation
# switched off around the black hole,
#   z4c/lapse_leak_hole = r_h   the term of z4c/lapse_leak is off within r_h of every
#                               compact-object tracker and acts in full beyond 2 r_h;
#   z4c/co_0_type = BH          a tracker at the puncture (it follows the hole).
# With the relaxation everywhere (first pass) the vacuum bubble is held on a slice that
# stretches the coordinates into the hole: the horizon shrinks in the coordinates (1.06 M
# at 100 M, 0.78 M at 200 M in Track D's run) and its mass drifts late. With r_h = 16 M
# the horizon keeps a radius of 1.6 M over 100 M; the relaxation is in full from 32 M on,
# the bubble wall is at 33 M in the coordinates. The wall tracers follow the exact curve
# to 2e-4 (30 M) and 6e-4 (100 M), three times less closely than with the relaxation
# everywhere: choose r_h so that 2 r_h stays inside the matter that needs the term.
# z4c/lapse_leak_hole=0.0 on the command line gives the condition of the first pass.
# Other changes against the parent: outer faces at +-128 M (cells 4 M beyond 64 M),
# tlim = 100, snap_dt. Built by tracks/core/analysis/gauge2/make_inputs.py.
# Header of the parent follows.
#
# Black hole in a vacuum bubble inside an expanding dust ball (Einstein-Straus type):
# Track D's data set (tracks/D-bh-dress/einstein_straus/ on branch track/D-bh-dress,
# make_es.py --Rb 56 --w_out 4 --hp 2.0: black hole M = 1, bubble wall at 36 M, dust
# plateau with H = 5.58e-3/M out to 60 M, total mass 2.74 M) evolved for a few tens of M
# with the gauge a puncture inside expanding dust needs (test ES of
# tracks/core/JOURNAL-gauge.md):
#   lapse  1+log with advection and relaxation of its excess over 1 (z4c/lapse_leak =
#          1/T, here T = 2 M: one dust cell); the puncture is sliced by plain 1+log,
#          the dust lapse stays near exp(6 T H) = 1.07 instead of growing as 1 + 6 ln a;
#          z4c/lapse_leak=0.0 gives the old condition;
#   shift  Gamma-driver with eta = 2/M, zero at the start;
#   start  lapse psi^-2 from the table, dust at rest in the coordinates.
# Mesh: cells 2 M everywhere (one lattice site per cell in the dust), halving to M/8
# within 2 M of the puncture; outer boundary at 96 M, further than the light travel
# time of a run of 30 M from the dust (the outflow condition is not transparent for
# the Painleve-Gullstrand exterior).  Give particles/particle_file and
# problem/comp0_file on the command line.  Track D's own first run (ES-1) uses a finer
# mesh and a boundary at 180 to 256 M.

<comment>
problem   = black hole in a vacuum bubble inside an expanding dust ball

<job>
basename  = es

<mesh>
nghost    = 4
nx1       = 64
x1min     = -128.0
x1max     = 128.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -128.0
x2max     = 128.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -128.0
x3max     = 128.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement       = static
max_nmb_per_rank = 1024

# root cells 4 M; 2 M for |x| < 64 M (the dust ends at 57 M in the coordinates and stays
# there: zero shift, lapse near 1); then halving down to M/8 for |x| < 4 M
<refined_region1>
level = 1
x1min = -63.9
x1max = 63.9
x2min = -63.9
x2max = 63.9
x3min = -63.9
x3max = 63.9

<refined_region2>
level = 5
x1min = -2.0
x1max = 2.0
x2min = -2.0
x2max = 2.0
x3min = -2.0
x3max = 2.0

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 100.0
ndiag      = 100

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
lapse_leak      = 0.5      # 1/T of the relaxation of the excess lapse (0: plain 1+log)
lapse_leak_alpha = 1.0     # reference lapse
lapse_leak_hole = 16.0     # r_h: relaxation off within r_h of the tracker at the puncture, in full
                           # beyond 2 r_h = 32 M (the bubble wall sits at 33 M in the coordinates)
co_0_type       = BH       # tracker at the puncture (for lapse_leak_hole)
co_0_x          = 0.0
co_0_y          = 0.0
co_0_z          = 0.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0

<fastflow>
find_every        = 16
metric_drvts      = interpolant
num_horizons      = 1
npunct            = 0
ntheta            = 16
lmax              = 8
use_puncture_0    = -1
center_x_0        = 0.0
center_y_0        = 0.0
center_z_0        = 0.0
initial_radius_0  = 0.839
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-5
start_time_0      = 0.0
stop_time_0       = 1.0e9
verbose           = false

<particles>
particle_type  = nrpic
pusher         = midpoint
metric         = mesh
interp         = hermite
tolerance      = 1.0e-10
max_iterations = 50
deposit        = true
deposit_shape  = cic
nfilter        = 1
filter_compensate = false
alpha_exc      = 0.05
hist_dcycle    = 4
traj_dcycle    = 8
traj_ntrack    = 140
snap_dt        = 25.0
particle_file  = es.nrp

<problem>
pgen_name  = nrpic_cf
ncomp      = 2
comp0_type = table
comp0_file = es.tab
comp1_type = puncture
comp1_mass = 1.0239688282062387
lapse      = table          # the alpha column: psi^-2 (precollapsed lapse of the full psi)
lapse_comp = 0
shift      = zero           # dust at rest in the coordinates; 'table': areal radius frozen at t = 0

<output1>
file_type = hst
dt        = 1.0
