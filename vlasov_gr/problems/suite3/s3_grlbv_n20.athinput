# Suite 3: Oppenheimer-Snyder collapse R_0 = 5M (Z4c + Loehner AMR + FastFlow)
<comment>
problem = s3_grlbv_n20

<job>
basename = s3_grlbv_n20

<mesh>
nghost    = 4
nx1       = 64
x1min     = -155.03721050993067
x1max     = 155.03721050993067
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 64
x2min     = -155.03721050993067
x2max     = 155.03721050993067
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 64
x3min     = -155.03721050993067
x3max     = 155.03721050993067
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement          = adaptive
num_levels          = 8
max_nmb_per_rank    = 1024
ncycle_check        = 4
refinement_interval = 8

<amr_criterion0>
method = user

<z4c_amr>
method          = lohner
lohner_refine   = 0.2
lohner_derefine = 0.02
lohner_eps      = 0.01
radius_0_rad      = 6.0
radius_0_reflevel = 4

<refined_region1>
level = 4
x1min = -6.0
x1max = 6.0
x2min = -6.0
x2max = 6.0
x3min = -6.0
x3max = 6.0

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = -1
tlim       = 25.000000
ndiag      = 20

<z4c>
lapse_oplog     = 2.0
lapse_harmonicf = 1.0
lapse_harmonic  = 0.0
lapse_advect    = 1.0
shift_Gamma     = 0.75
shift_eta       = 2.0
shift_advect    = 1.0
diss            = 0.5
chi_div_floor   = 1.0e-5
damp_kappa1     = 0.02
damp_kappa2     = 0.0
damp_ch         = 0.0
damp_ch_dx      = 0.0

<fastflow>
find_every        = 16
metric_drvts      = interpolant
num_horizons      = 1
npunct            = 0
ntheta            = 16
lmax              = 8
use_puncture_0    = -1
center_x_0        = 0.0
center_y_0        = 0.0
center_z_0        = 0.0
initial_radius_0  = 1.0
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 1.0
hmean_tol_0       = 100.0
mass_tol_0        = 1.0e-5
start_time_0      = 8.0
stop_time_0       = 1000.0
verbose           = false

<particles>
particle_type       = nrpic
pusher              = vlasov_mfm
metric              = mesh
tolerance           = 1.0e-7
max_iterations      = 50
deposit             = true
nfilter             = 1
filter_compensate   = false
filter_comp_c       = -1.0
deposit_max_level   = 31
deposit_adaptive    = false
deposit_min_level   = 4
deposit_ppc         = 1.0
deposit_max_coarsen = 31
alpha_exc           = 0.1
hist_dcycle         = 1
snap_dt             = 2.5
particle_file       = /weka/scratch/schmidt/ssci-anima/ssci-haiyangw/nrpic_grlbv/runs/stage4a/suite3/ic_s3_grlbv_n20.grlbv
vlasov_basis        = tophat
vlasov_nperp        = 3
vlasov_nq_kick      = 1
vlasov_nq_dep       = 1
vlasov_pair_mode    = covariant
vlasov_analytic_vf  = false
vlasov_substeps     = 1
vlasov_cfl          = 0.3
vlasov_bnd_detect   = true

<problem>
pgen_name  = nrpic_cf
ncomp      = 1
comp0_type = table
comp0_file = /weka/scratch/schmidt/ssci-anima/ssci-haiyangw/nrpic_grlbv/runs/stage4a/suite3/os_R5.tab
lapse      = one

<output1>
file_type = hst
dt        = 0.1
